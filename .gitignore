*.o
copper-sh
iso/work/
iso/out/iso-artifact*/

# Build output. iso/build.sh stages the whole rootfs under iso-artifact*/ before
# grub-mkrescue runs, so a build leaves several hundred megabytes of unpacked
# tree and finished .iso files in the working directory. None of it is source.
iso-artifact/
iso-artifact[0-9]*/
iso-main-latest/

# Python bytecode from tests/firstboot-drive.py.
__pycache__/
*.pyc

# Firefox package payload and its staging tree (build-firefox-pkg.sh). The
# tarball is uploaded to GitHub Releases, not committed.
firefox-*.tar.gz
firefox-pkg-work/

# Theme installer build output and Ingot payload (build-theme-installer-pkg.sh).
apps/copper-theme-installer/copper-theme-installer
copper-theme-installer-*.tar.gz

# The bug log. It is a working notebook -- read, appended to and argued with
# locally -- not part of the tree: nothing in the build reads it, and an entry
# is worth writing before there is a fix to commit. Keeping it here means the
# file survives, and stays out of every diff.
BUGS.md