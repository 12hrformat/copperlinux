#!/bin/busybox sh
# copper live initramfs -- find the Copper medium, build a writable overlay
# on top of the read-only ISO, then hand over to copper-init (our PID 1).

PATH=/bin:/sbin:/usr/bin:/usr/sbin

# /dev/console is whichever console= was last, and the only place userspace output
# goes. On a VM with a file-backed serial port the screen gets none of ours, so
# say it in both places. "quiet" keeps the screen for Plymouth and [ OK ] lines;
# verbose/debug entries still print everything.
QUIET=0

say() {
    [ "$QUIET" = 1 ] || echo "copper: $*"
    if [ -c /dev/ttyS0 ]; then
        echo "copper: $*" > /dev/ttyS0 2>/dev/null || true
    fi
}

# Failures always reach the screen, even in quiet mode: a silent boot is worse.
notice() {
    echo "copper: $*"
    if [ -c /dev/ttyS0 ]; then
        echo "copper: $*" > /dev/ttyS0 2>/dev/null || true
    fi
}

/bin/busybox mount -t proc proc /proc 2>/dev/null
# The kernel command line is read ONCE here, with the `read` builtin into $cmdline.
# There are no applets in this initramfs -- only /bin/busybox and this script --
# so re-reading the command line through an external cat later finds no binary,
# fails silently and looks like "no arguments"; that is how copper.init=systemd
# came to be ignored. Anything
# outside the shell must be spelled /bin/busybox <applet>.
cmdline=
read -r cmdline < /proc/cmdline 2>/dev/null || :
case " $cmdline " in
    *" quiet "*) QUIET=1 ;;
esac
/bin/busybox mount -t sysfs sysfs /sys 2>/dev/null
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
# FUSE is built in, so devtmpfs normally publishes /dev/fuse; make the node
# explicitly for kernels that expose it late (major 10, minor 229).
if [ ! -c /dev/fuse ]; then
    /bin/busybox mknod /dev/fuse c 10 229 2>/dev/null || :
fi
/bin/busybox mkdir -p /mnt/root /mnt/upper /mnt/merged /run

# Once in a shell there is no display and no ssh, so name the step that broke
# instead of leaving "it didn't boot" as the only report.
rescue() {
    notice ""
    notice "$1"
    notice "dropping to a shell on /dev/console so you can look around"
    exec /bin/busybox sh < /dev/console > /dev/console 2>&1
}

MEDIA=""
find_media() {
    for dev in /dev/sr[0-9]* /dev/sd[a-z] /dev/sd[a-z][0-9]* \
               /dev/hd[a-z] /dev/hd[a-z][0-9]* /dev/vd[a-z] /dev/vd[a-z][0-9]* \
               /dev/nvme0n1p[0-9]*; do
        [ -b "$dev" ] || continue
        /bin/busybox mount -t iso9660 -o ro "$dev" /mnt/root 2>/dev/null || continue
# The marker is written by build_iso for every bootloader; grub.cfg is a
# fallback for older media, since a systemd-boot provider need not ship GRUB.
        if [ -f /mnt/root/boot/copper-media ]; then
            MEDIA="$dev"
            return 0
        fi
        if [ -f /mnt/root/boot/grub/grub.cfg ]; then
            MEDIA="$dev"
            return 0
        fi
        /bin/busybox umount /mnt/root 2>/dev/null
    done
    return 1
}

find_media || rescue "no Copper medium: looked for an iso9660 filesystem with /boot/copper-media on it"
say "initramfs up, medium is $MEDIA"

# Writable top layer over the read-only ISO: RAM, or a disk the user handed over.
# A disk qualifies only by the COPPER label the wizard writes; no guess touches a
# disk, and a broken labeled disk falls back to RAM rather than costing a boot.
#
# upper/ and work/ are made INSIDE whatever gets mounted: a directory created
# before a mount is covered by it, so the overlay would fail with ENOENT on
# upperdir even though the mount below looks healthy (build.sh pre-creates them too).

# The device the upper actually landed on. Empty means RAM.
UPPER_DEV=""
find_upper() {
    for dev in /dev/sd[a-z][0-9]* /dev/sd[a-z] \
               /dev/vd[a-z][0-9]* /dev/vd[a-z] \
               /dev/hd[a-z] /dev/hd[a-z][0-9]* \
               /dev/nvme[0-9]n[0-9]p[0-9]* /dev/nvme[0-9]n[0-9] \
               /dev/mmcblk[0-9]p[0-9]* /dev/mmcblk[0-9]; do
        [ -b "$dev" ] || continue
        # Never the disc we booted from, and never a partition of it.
        [ "$dev" = "$MEDIA" ] && continue
        case "$dev"  in "$MEDIA"*) continue ;; esac
        case "$MEDIA" in "$dev"*)  continue ;; esac
        # Anything already mounted belongs to somebody else.
        /bin/busybox grep -q "^$dev " /proc/mounts 2>/dev/null && continue
        # One probe per candidate: ask the filesystem for its own label.
        info=$(/bin/busybox blkid "$dev" 2>/dev/null) || continue
        case "$info" in
            *'LABEL="COPPER"'*) UPPER_DEV="$dev"; return 0 ;;
        esac
    done
    return 1
}

if find_upper; then
    say "persistent upper: $UPPER_DEV carries the COPPER label"
    if ! /bin/busybox mount -t ext4 -o rw "$UPPER_DEV" /mnt/upper; then
        notice "$UPPER_DEV would not mount -- running this session in RAM"
        UPPER_DEV=""
    fi
fi

if [ -z "$UPPER_DEV" ]; then
# Size the tmpfs at 50%: firefox's 120M payload and its ~450M unpacked tree coexist
# before the payload is removed, so a 25% cap (512M on a 2G VM) dies mid-unpack.
# The other half stays for the running system.
    if ! /bin/busybox mount -t tmpfs -o size=50% tmpfs /mnt/upper; then
        rescue "cannot mount tmpfs on /mnt/upper (no writable layer for the session)"
    fi
    say "writable layer is RAM -- nothing here survives a reboot"
else
    say "writable layer is $UPPER_DEV -- files survive a reboot"
fi

if ! /bin/busybox mkdir -p /mnt/upper/upper /mnt/upper/work; then
    rescue "cannot create /mnt/upper/upper and /mnt/upper/work in the writable layer"
fi

# A power cut leaves overlay work/ dirty and the mount refuses it; work/ is
# scratch that overlay rebuilds, upper/ holds user files and is never touched.
if [ -n "$UPPER_DEV" ]; then
    /bin/busybox rm -rf /mnt/upper/work 2>/dev/null
    /bin/busybox mkdir -p /mnt/upper/work
fi

/bin/busybox mount -t overlay overlay \
    -o lowerdir=/mnt/root,upperdir=/mnt/upper/upper,workdir=/mnt/upper/work \
    /mnt/merged || rescue "overlay mount failed: lowerdir=/mnt/root upperdir=/mnt/upper/upper workdir=/mnt/upper/work"

/bin/busybox mount -t proc proc /mnt/merged/proc 2>/dev/null
/bin/busybox mount -t sysfs sysfs /mnt/merged/sys 2>/dev/null
/bin/busybox mount -t devtmpfs devtmpfs /mnt/merged/dev 2>/dev/null
# devtmpfs gives device nodes, not ptys: without devpts, sudo dies with "unable to
# allocate pty" and every terminal emulator fails. Mount it on the merged root's
# /dev and link /dev/ptmx to pts/ptmx in case the legacy node is missing.
/bin/busybox mkdir -p /mnt/merged/dev/pts 2>/dev/null
/bin/busybox mount -t devpts devpts /mnt/merged/dev/pts 2>/dev/null || \
    notice "devpts failed to mount: sudo and terminals will not work"
[ -e /mnt/merged/dev/ptmx ] || /bin/busybox ln -s pts/ptmx /mnt/merged/dev/ptmx 2>/dev/null
/bin/busybox mkdir -p /mnt/merged/run
/bin/busybox mount -t tmpfs tmpfs /mnt/merged/run 2>/dev/null
# /tmp is shared and world-writable: logins, Xorg and ingot all use it. Give it
# its own tmpfs with no setuid devices or executable files, so a planted symlink
# or drop-in binary cannot be executed from there. The overlay upper stays a
# separate, executable tmpfs for ingot's installed binaries.
/bin/busybox mkdir -p /mnt/merged/tmp /mnt/merged/tmp/.X11-unix 2>/dev/null
if ! /bin/busybox mount -t tmpfs -o nosuid,nodev,noexec,size=50% tmpfs /mnt/merged/tmp 2>/dev/null; then
    notice "could not mount /tmp with nosuid,nodev,noexec; continuing on the overlay"
else
    /bin/busybox chmod 1777 /mnt/merged/tmp 2>/dev/null
    /bin/busybox chmod 1777 /mnt/merged/tmp/.X11-unix 2>/dev/null
fi

# Tell the wizard which disc we booted from and where the writable layer landed.
# The file goes on the overlay, not /run, because copper-init mounts a fresh
# tmpfs over /run a moment later and would bury it.
/bin/busybox mkdir -p /mnt/merged/var/lib/copper
{
    echo "media=$MEDIA"
    echo "upper=${UPPER_DEV:-ram}"
} > /mnt/merged/var/lib/copper/live-boot

# Which init runs as PID 1.

# The kernel command line wins (the systemd entry passes copper.init=systemd);
# with no word, /etc/copper-init is the wizard's saved answer, carried across by
# the overlay. An image without systemd falls back to copper-init.
# $cmdline was read at the top -- do NOT re-read /proc/cmdline with cat: there is
# no cat here and its silent failure looks exactly like "no arguments". Unquoted
# on purpose: the loop wants word splitting.
init_choice=
for arg in $cmdline; do
    case "$arg" in
        copper.init=systemd) init_choice=systemd ;;
        copper.init=busybox) init_choice=busybox ;;
    esac
done
if [ -z "$init_choice" ]; then
    init_choice=busybox
    if [ -r /mnt/merged/etc/copper-init ]; then
        saved=
        read -r saved < /mnt/merged/etc/copper-init 2>/dev/null || :
        [ "$saved" = systemd ] && init_choice=systemd
    fi
fi

# Name the missing file: switch_root on a root with no init gives one bare
# "not found". Test the binary, not /sbin/init: its absolute symlink resolves
# against the initramfs root before chroot, where /usr/bin does not exist.
[ -x /mnt/merged/usr/bin/copper-init ] \
    || rescue "no copper-init in the merged root (it did not get built into the ISO)"

if [ "$init_choice" = systemd ]; then
    if [ -x /mnt/merged/lib/systemd/systemd ]; then
        say "handing over to systemd (copper.init=systemd)"
        exec /bin/busybox switch_root /mnt/merged /lib/systemd/systemd
    fi
    notice "systemd was asked for but is not in this image; using copper-init"
fi

say "handing over to copper-init"
exec /bin/busybox switch_root /mnt/merged /sbin/init
