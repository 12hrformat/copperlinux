
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Copper Linux — default Fastfetch configuration
    // Logo generated from Copper's own artwork for terminal compatibility.

    "logo": {
        "source": "/usr/share/copper/fastfetch-logo.txt",
        "type": "file",
        "padding": {
            "top": 1,
            "right": 4,
            "left": 2
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "format": "{#34}{user-name}{#keys}@{#34}{host-name}{#default}"
        },
        {
            "type": "custom",
            "format": "{#34}──────────────────────────────{#default}"
        },
        {
            "type": "os",
            "key": "  OS"
        },
        {
            "type": "host",
            "key": "  Host"
        },
        {
            "type": "kernel",
            "key": "  Kernel"
        },
        {
            "type": "uptime",
            "key": "  Uptime"
        },
        {
            "type": "packages",
            "key": "  Packages"
        },
        {
            "type": "shell",
            "key": "  Shell"
        },
        {
            "type": "display",
            "key": "  Display"
        },
        {
            "type": "de",
            "key": "  Desktop"
        },
        {
            "type": "wm",
            "key": "  WM"
        },
        {
            "type": "terminal",
            "key": "  Terminal"
        },
        {
            "type": "cpu",
            "key": "  CPU",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "  GPU"
        },
        {
            "type": "memory",
            "key": "  Memory"
        },
        {
            "type": "disk",
            "key": "  Disk",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "{#34}──────────────────────────────{#default}"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
