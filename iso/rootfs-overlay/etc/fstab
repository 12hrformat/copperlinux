# Copper Linux
# Copper live session. The rootfs is a read-only ISO with a tmpfs overlay,
# so only /tmp (and the overlay) are writable. live/init mounts /tmp with these
# flags before PID 1 starts; this line only matters if something runs `mount -a`,
# so keep its cap in step with the overlay's (an ingot payload download plus its
# unpacked tree need the room).
tmpfs        /tmp     tmpfs   nosuid,nodev,noexec,size=50%   0 0
