#!/bin/sh
# Copper Linux
#
# default.script -- what udhcpc runs on every lease change: install the offered
# address and route, then write resolv.conf with DHCP resolvers first and public
# ones after. Env from udhcpc: interface ip subnet mask broadcast router dns domain lease.
# `subnet` is a dotted-quad mask (DHCP option 1), so convert it to a prefix length.

RESOLV_CONF=/etc/resolv.conf

[ -n "$1" ] || exit 1

# To the screen and the serial port: stdout alone leaves a serial log empty on a quiet boot.
say() {
    echo "copper-net: $*"
    if [ -c /dev/ttyS0 ]; then
        echo "copper-net: $*" > /dev/ttyS0 2>/dev/null || true
    fi
}

# Netmask -> prefix by counting leading ones; reject a non-contiguous mask.
mask_to_prefix() {
    local m="$1" n=0 zeros=0 o
    [ -n "$m" ] || return 1

    # Split on the dots into one to four octets.
    local oldifs="$IFS"
    IFS=.
    set -f                  # keep "*" in a bad value from globbing the rootfs
    set -- $m
    set +f
# Field splitting drops stray dots/spaces, so insist the octets spell the original.
    [ "$*" = "$m" ] || return 1
    IFS="$oldifs"
    if [ "$#" -lt 1 ] || [ "$#" -gt 4 ]; then
        return 1
    fi

    for o in "$@"; do
        case "$o" in
            0)
                zeros=1
                ;;
            255|254|252|248|240|224|192|128)
# Ones after a zero would make a non-contiguous mask, which is not a netmask.
                [ "$zeros" -eq 0 ] || return 1
                case "$o" in
                    255) n=$((n + 8)) ;;
                    254) n=$((n + 7)) ;;
                    252) n=$((n + 6)) ;;
                    248) n=$((n + 5)) ;;
                    240) n=$((n + 4)) ;;
                    224) n=$((n + 3)) ;;
                    192) n=$((n + 2)) ;;
                    128) n=$((n + 1)) ;;
                esac
                ;;
            *)
                return 1
                ;;
        esac
    done
    echo "$n"
}

case "$1" in
deconfig)
    say "dropping the address on $interface"
    ip -4 addr flush dev "$interface"
    ip link set dev "$interface" up
    ;;

bound|renew)
# A server may omit the netmask: guessing /24 beats a /32 through the gateway.
# Honour a broadcast the server sends; $bcast is unquoted so it splits into two words.
    prefix=$(mask_to_prefix "$subnet") || prefix=24
    say "$interface leased $ip/$prefix"

    bcast=""
    [ -n "$broadcast" ] && bcast="broadcast $broadcast"
    ip addr add "$ip/$prefix" $bcast dev "$interface"

    if [ -n "$router" ]; then
# Clear the old default route on renewals instead of stacking another one.
        while ip route del default dev "$interface" 2>/dev/null; do
            :
        done
        for gw in $router; do
            say "default route via $gw"
            ip route add default via "$gw" dev "$interface"
        done
    fi

    tmp="$RESOLV_CONF.copper.$$"
    : > "$tmp"
    [ -n "$domain" ] && echo "search $domain" >> "$tmp"
# The lease's own resolver comes first: it is local, and on a network that blocks
# public DNS it is the only one that answers. Public fallbacks follow for a lease
# that carries no nameserver -- the old `-s "$tmp"` guard only fired with a search
# domain, so a normal lease left the file untouched and every lookup died.
    for ns in $dns; do
        case " 1.1.1.1 9.9.9.9 " in
            *" $ns "*) ;;
            *)
                say "DHCP nameserver $ns"
                echo "nameserver $ns" >> "$tmp"
                ;;
        esac
    done
    for ns in 1.1.1.1 9.9.9.9; do
        say "nameserver $ns"
        echo "nameserver $ns" >> "$tmp"
    done
    mv "$tmp" "$RESOLV_CONF"
    ;;

leasefail)
    say "no lease on $interface yet, still asking"
    ;;
esac

exit 0
