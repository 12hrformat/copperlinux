#!/bin/sh
# copper-audio -- the mixer and the audio servers, from one command.
#
# The image ships both servers (pulseaudio, and pipewire + wireplumber +
# pipewire-pulse) and a session starts the one /etc/copper.conf names. What
# neither the kernel config nor the server can do is raise the mixer: an HDA
# codec comes out of reset with its outputs muted or at zero on plenty of
# machines, and a live image persists no mixer state. A running server over a
# muted card is a silent machine that reports itself healthy in every log.
#
# So:
#
#   copper-audio           same as status
#   copper-audio init      unmute and raise the ALSA controls on every card,
#                          then unmute the server's default sink and store the
#                          mixer state (root)
#   copper-audio status    cards, mixer levels, sinks, which server is running
#   copper-audio test      1 second of 440 Hz on the default device
#   copper-audio server    print the backend and whether it is up
#
# Both launchers call `copper-audio init` after the server starts, so a fresh
# boot is audible without anyone opening a mixer. Nothing here is fatal: a
# machine with no card still boots, it is just quiet.
#
# Raising ALSA alone is not enough. PulseAudio and PipeWire keep their OWN mute
# and volume on the sink they hand to clients, and a fresh server can come up
# with that sink muted or pointed at the null output. That is the machine where
# cava draws bars from the monitor source while Firefox plays a video and
# nothing reaches the speakers: the graph sees the stream, the sink swallows
# it. So init also talks to the server over the Pulse protocol -- pactl works
# against both the PulseAudio daemon and pipewire-pulse -- picks a real sink if
# the default is the null one, and unmutes it.

set -u

CONF=${COPPER_CONF:-/etc/copper.conf}
RT=${XDG_RUNTIME_DIR:-/tmp}

say() { printf 'copper-audio: %s\n' "$*" >&2; }

# The same reader the launchers use, so "which server" has one answer.
backend() {
    _w=
    if [ -r "$CONF" ]; then
        _w=$(sed -n 's/^[[:space:]]*audio[[:space:]]*=[[:space:]]*\([a-z]*\).*$/\1/p' \
                 "$CONF" 2>/dev/null | tail -n 1)
    fi
    case "$_w" in
        pipewire) printf '%s\n' pipewire ;;
        *)        printf '%s\n' pulseaudio ;;
    esac
}

# Card indices, one per line, from the kernel's own list rather than from
# /dev/snd ordering (controlC0 and pcmC0D0p can be missing independently).
cards() {
    sed -n 's/^ *\([0-9][0-9]*\) \[.*/\1/p' /proc/asound/cards 2>/dev/null
}

have() { command -v "$1" >/dev/null 2>&1; }

# The server may still be bringing the sink up when init runs. pactl needs the
# Pulse-protocol socket specifically -- pipewire's own graph socket can be up a
# moment before pipewire-pulse publishes its -- so wait for that one, whatever
# backend the config chose. That is what keeps this from unmuting a sink that
# does not exist yet.
pulse_ready() {
    [ -S "$RT/pulse/native" ] || [ -n "${PULSE_SERVER:-}" ]
}

# Server-side mute/volume and the default device. pactl is in pulseaudio-utils
# and speaks to both daemons, so the same commands cover either /etc/copper.conf
# choice. A null sink is a real sink as far as the server is concerned -- cava's
# monitor follows it, which is why the bars move with no sound -- so prefer a
# listed hardware sink whenever one shows up.
server_unmute() {
    have pactl || return 0
    _i=0
    while [ "$_i" -lt 8 ] && ! pulse_ready; do
        sleep 1
        _i=$((_i + 1))
    done
    pulse_ready || return 0

    _def=$(pactl get-default-sink 2>/dev/null) || _def=
    case "$_def" in
        ''|*null*)
            _real=$(pactl list short sinks 2>/dev/null \
                    | while read -r _idx _name _rest; do
                          case "$_name" in *null*) ;; *) printf '%s\n' "$_name"; break ;; esac
                      done)
            if [ -n "$_real" ]; then
                pactl set-default-sink "$_real" >/dev/null 2>&1 && _def=$_real
                say "server: default sink is $_real"
            fi
            ;;
    esac

    # Unmute every listed sink, then make certain the default one is at a
    # usable level. Setting each by name also covers a machine with both an
    # analogue and an HDMI output where only one is the default.
    pactl list short sinks 2>/dev/null | while read -r _idx _name _rest; do
        pactl set-sink-mute "$_name" 0 >/dev/null 2>&1 || :
        pactl set-sink-volume "$_name" 100% >/dev/null 2>&1 || :
    done
    if [ -n "$_def" ]; then
        pactl set-sink-mute "$_def" 0 >/dev/null 2>&1 || :
        pactl set-sink-volume "$_def" 100% >/dev/null 2>&1 || :
    fi
    say "server: sinks unmuted"
}

# Playback control names by codec: Master/PCM on most HDA, Speaker/Headphone on
# laptops, Front/Surround/Center/LFE on 5.1, HDMI on the digital outputs. A name
# the card does not have makes amixer exit nonzero and is skipped.
raise_card() { # raise_card <index>
    _c=$1
    _done=
    for _n in Master PCM Speaker Headphone Front Surround Center LFE HDMI; do
        if amixer -c "$_c" -q sset "$_n" 80% unmute >/dev/null 2>&1; then
            _done="$_done $_n"
        fi
    done
    if [ -n "$_done" ]; then
        say "card $_c: raised$_done"
    else
        say "card $_c: no playback control this tool knows; check 'amixer -c $_c scontrols'"
    fi
    # A capture side left at zero is the other half of "the microphone does not
    # work"; raise it too, since nothing else in the image does.
    for _n in Capture "Mic" "Internal Mic"; do
        amixer -c "$_c" -q sset "$_n" 70% cap >/dev/null 2>&1 || :
    done
}

cmd_init() {
    if [ ! -r /proc/asound/cards ]; then
        say "this kernel has no /proc/asound; no sound support built in"
        return 1
    fi
    _cs=$(cards)
    if [ -z "$_cs" ]; then
        say "no sound card: the kernel found no HDA codec"
        return 1
    fi
    if ! have amixer; then
        say "amixer is not installed (alsa-utils); cannot raise the mixer"
        return 1
    fi
    for _c in $_cs; do
        raise_card "$_c"
    done
    # Store it, so a persisted install keeps the levels across boots. On a live
    # session this lands in the overlay and does not survive a reboot, which is
    # why the launchers call init on every boot instead of trusting the file.
    #
    # alsactl is /usr/sbin/alsactl, not /usr/bin: a plain `command -v alsactl`
    # misses it on any PATH without the sbin directories (which is the default
    # for a non-root login), so it is looked up by absolute path as well.
    _alsactl=
    for _p in /usr/sbin/alsactl /sbin/alsactl /usr/bin/alsactl; do
        if [ -x "$_p" ]; then _alsactl=$_p; break; fi
    done
    if [ -n "$_alsactl" ] && [ "$(id -u 2>/dev/null || echo 1)" = 0 ]; then
        "$_alsactl" store >/dev/null 2>&1 || :
    fi
    # The hardware is up; now make the graph above it deliver sound. This is
    # deliberately after the ALSA work so a muted codec and a muted sink are
    # both cleared on the same boot, whatever backend the config selected.
    server_unmute
    return 0
}

server_state() {
    case "$(backend)" in
    pipewire)
        if [ -S "$RT/pipewire-0" ]; then
            printf 'pipewire: running (socket %s/pipewire-0)\n' "$RT"
        else
            printf 'pipewire: not running\n'
        fi
        ;;
    *)
        if [ -S "$RT/pulse/native" ]; then
            printf 'pulseaudio: running (socket %s/pulse/native)\n' "$RT"
        elif [ -n "${PULSE_SERVER:-}" ]; then
            printf 'pulseaudio: client points at %s\n' "$PULSE_SERVER"
        else
            printf 'pulseaudio: not running\n'
        fi
        ;;
    esac
}

cmd_status() {
    printf 'selected: %s (/etc/copper.conf)\n' "$(backend)"
    server_state
    if [ -r /proc/asound/cards ]; then
        printf '\ncards (/proc/asound/cards):\n'
        sed 's/^/  /' /proc/asound/cards
    else
        printf '\ncards: none -- this kernel has no sound support\n'
    fi
    for _c in $(cards); do
        if have amixer; then
            printf '\nmixer, card %s:\n' "$_c"
            amixer -c "$_c" sget Master 2>/dev/null \
                | grep -E 'Playback|Mono' | sed 's/^/  /' \
                || printf '  (no Master control on this card)\n'
        fi
    done
    if have pactl && pulse_ready; then
        printf '\ndefault sink: %s\n' "$(pactl get-default-sink 2>/dev/null)"
        pactl list short sinks 2>/dev/null | sed 's/^/  /'
    fi
}

cmd_test() {
    if have speaker-test; then
        say "440 Hz, 1 second, on the default device"
        if speaker-test -q -t sine -f 440 -l 1 -c 2 >/dev/null 2>&1; then
            say "tone played"
            return 0
        fi
        say "speaker-test failed: the card is busy or the mixer is still down"
        return 1
    fi
    say "speaker-test is not installed (alsa-utils)"
    return 1
}

case "${1:-status}" in
    init)   cmd_init ;;
    status) cmd_status ;;
    test)   cmd_test ;;
    server) server_state ;;
    -h|--help|help)
        sed -n 's/^# \{0,1\}//p' "$0" | sed -n '/^  copper-audio/,/^$/p'
        ;;
    *)
        say "unknown command '$1'; try: copper-audio [init|status|test|server]"
        exit 2
        ;;
esac
