#!/bin/sh
# copper-audio -- the mixer and the audio servers, from one command.
# A live image persists no mixer state, and an HDA codec often boots muted:
# a healthy-looking server on a silent card. Nothing here is fatal -- no card
# still boots, just quietly. Both launchers call `init` after the server starts.
#   copper-audio           same as status
#   copper-audio init      unmute and raise the ALSA controls on every card,
#                          then unmute the server's default sink and source and
#                          store the mixer state (root)
#   copper-audio status    cards, mixer levels, sinks, sources, server state
#   copper-audio test      1 second of 440 Hz on the default device
#   copper-audio server    print the backend and whether it is up
#
# init raises the ALSA controls, then the server's default sink and source.
#
# PulseAudio and PipeWire keep their OWN mute/volume: a fresh server can be muted
# or pointed at the null sink, so the graph sees the stream but nothing reaches
# the speakers, or a browser sees a monitor source but never hears the user.
# Raising ALSA alone is not enough -- talk to the server over the Pulse protocol.

set -u

CONF=${COPPER_CONF:-/etc/copper.conf}
RT=${XDG_RUNTIME_DIR:-/tmp}

say() { printf 'copper-audio: %s\n' "$*" >&2; }

# The same reader the launchers use, so "which server" has one answer.
backend() {
    _w=
    if [ -r "$CONF" ]; then
        _w=$(sed -n 's/^[[:space:]]*audio[[:space:]]*=[[:space:]]*\([a-z]*\).*$/\1/p' \
                 "$CONF" 2>/dev/null | tail -n 1)
    fi
    case "$_w" in
        pipewire) printf '%s\n' pipewire ;;
        *)        printf '%s\n' pulseaudio ;;
    esac
}

# Card indices from the kernel's own list, not /dev/snd ordering.
cards() {
    sed -n 's/^ *\([0-9][0-9]*\) \[.*/\1/p' /proc/asound/cards 2>/dev/null
}

have() { command -v "$1" >/dev/null 2>&1; }

# Wait for the Pulse-protocol socket specifically: pipewire's graph socket can
# appear before pipewire-pulse publishes its, so a sink may not exist yet.
pulse_ready() {
    [ -S "$RT/pulse/native" ] || [ -n "${PULSE_SERVER:-}" ]
}

# pactl speaks to both daemons. A null sink is a real sink to the server -- cava's
# monitor follows it -- so prefer a listed hardware sink over the default.
server_unmute() {
    have pactl || return 0
    _i=0
    while [ "$_i" -lt 8 ] && ! pulse_ready; do
        sleep 1
        _i=$((_i + 1))
    done
    pulse_ready || return 0

    _def=$(pactl get-default-sink 2>/dev/null) || _def=
    case "$_def" in
        ''|*null*)
            _real=$(pactl list short sinks 2>/dev/null \
                    | while read -r _idx _name _rest; do
                          case "$_name" in *null*) ;; *) printf '%s\n' "$_name"; break ;; esac
                      done)
            if [ -n "$_real" ]; then
                pactl set-default-sink "$_real" >/dev/null 2>&1 && _def=$_real
                say "server: default sink is $_real"
            fi
            ;;
    esac

# Unmute each sink by name, then make sure the default one is at a usable level.
    pactl list short sinks 2>/dev/null | while read -r _idx _name _rest; do
        pactl set-sink-mute "$_name" 0 >/dev/null 2>&1 || :
        pactl set-sink-volume "$_name" 100% >/dev/null 2>&1 || :
    done
    if [ -n "$_def" ]; then
        pactl set-sink-mute "$_def" 0 >/dev/null 2>&1 || :
        pactl set-sink-volume "$_def" 100% >/dev/null 2>&1 || :
    fi
    say "server: sinks unmuted"

# A monitor source is the sink's own playback, not a microphone. Pick the first
# real source and raise it too, on top of the ALSA Capture controls.
    _defsrc=$(pactl get-default-source 2>/dev/null) || _defsrc=
    case "$_defsrc" in
        ''|*null*|*.monitor)
            _realsrc=$(pactl list short sources 2>/dev/null \
                       | while read -r _idx _name _rest; do
                             case "$_name" in *null*|*.monitor) ;; *) printf '%s\n' "$_name"; break ;; esac
                         done)
            if [ -n "$_realsrc" ]; then
                pactl set-default-source "$_realsrc" >/dev/null 2>&1 && _defsrc=$_realsrc
                say "server: default source is $_realsrc"
            fi
            ;;
    esac
    pactl list short sources 2>/dev/null | while read -r _idx _name _rest; do
        case "$_name" in *.monitor) continue ;; esac
        pactl set-source-mute "$_name" 0 >/dev/null 2>&1 || :
        pactl set-source-volume "$_name" 100% >/dev/null 2>&1 || :
    done
    case "${_defsrc:-}" in
        ''|*.monitor) ;;
        *) pactl set-source-mute "$_defsrc" 0 >/dev/null 2>&1 || :
           pactl set-source-volume "$_defsrc" 100% >/dev/null 2>&1 || : ;;
    esac
    say "server: sources unmuted"
}

# Playback control names by codec; a name the card lacks is skipped.
raise_card() { # raise_card <index>
    _c=$1
    _done=
    for _n in Master PCM Speaker Headphone Front Surround Center LFE HDMI; do
        if amixer -c "$_c" -q sset "$_n" 80% unmute >/dev/null 2>&1; then
            _done="$_done $_n"
        fi
    done
    if [ -n "$_done" ]; then
        say "card $_c: raised$_done"
    else
        say "card $_c: no playback control this tool knows; check 'amixer -c $_c scontrols'"
    fi
# A capture side left at zero is the other half of a dead microphone.
    for _n in Capture "Mic" "Internal Mic" "Mic Boost" "Front Mic" "Line" "Line In"; do
        amixer -c "$_c" -q sset "$_n" 100% cap >/dev/null 2>&1 || :
    done
}

cmd_init() {
    if [ ! -r /proc/asound/cards ]; then
        say "this kernel has no /proc/asound; no sound support built in"
        return 1
    fi
    _cs=$(cards)
    if [ -z "$_cs" ]; then
        say "no sound card: the kernel found no HDA codec"
        return 1
    fi
    if ! have amixer; then
        say "amixer is not installed (alsa-utils); cannot raise the mixer"
        return 1
    fi
    for _c in $_cs; do
        raise_card "$_c"
    done
# Store the levels across boots where state persists; on a live image the file
# lands in the overlay, so the launchers call init every boot instead.
# alsactl lives in /usr/sbin, not /usr/bin: a plain `command -v` misses it on a
# non-root PATH, so look it up by absolute path as well.
    _alsactl=
    for _p in /usr/sbin/alsactl /sbin/alsactl /usr/bin/alsactl; do
        if [ -x "$_p" ]; then _alsactl=$_p; break; fi
    done
    if [ -n "$_alsactl" ] && [ "$(id -u 2>/dev/null || echo 1)" = 0 ]; then
        "$_alsactl" store >/dev/null 2>&1 || :
    fi
# Clear the server-side graph after the ALSA work, whatever backend was chosen.
    server_unmute
    return 0
}

server_state() {
    case "$(backend)" in
    pipewire)
        if [ -S "$RT/pipewire-0" ]; then
            printf 'pipewire: running (socket %s/pipewire-0)\n' "$RT"
        else
            printf 'pipewire: not running\n'
        fi
        ;;
    *)
        if [ -S "$RT/pulse/native" ]; then
            printf 'pulseaudio: running (socket %s/pulse/native)\n' "$RT"
        elif [ -n "${PULSE_SERVER:-}" ]; then
            printf 'pulseaudio: client points at %s\n' "$PULSE_SERVER"
        else
            printf 'pulseaudio: not running\n'
        fi
        ;;
    esac
}

cmd_status() {
    printf 'selected: %s (/etc/copper.conf)\n' "$(backend)"
    server_state
    if [ -r /proc/asound/cards ]; then
        printf '\ncards (/proc/asound/cards):\n'
        sed 's/^/  /' /proc/asound/cards
    else
        printf '\ncards: none -- this kernel has no sound support\n'
    fi
    for _c in $(cards); do
        if have amixer; then
            printf '\nmixer, card %s:\n' "$_c"
            amixer -c "$_c" sget Master 2>/dev/null \
                | grep -E 'Playback|Mono' | sed 's/^/  /' \
                || printf '  (no Master control on this card)\n'
        fi
    done
    if have pactl && pulse_ready; then
        printf '\ndefault sink: %s\n' "$(pactl get-default-sink 2>/dev/null)"
        pactl list short sinks 2>/dev/null | sed 's/^/  /'
        printf '\ndefault source: %s\n' "$(pactl get-default-source 2>/dev/null)"
        pactl list short sources 2>/dev/null | sed 's/^/  /'
    fi
}

cmd_test() {
    if have speaker-test; then
        say "440 Hz, 1 second, on the default device"
        if speaker-test -q -t sine -f 440 -l 1 -c 2 >/dev/null 2>&1; then
            say "tone played"
            return 0
        fi
        say "speaker-test failed: the card is busy or the mixer is still down"
        return 1
    fi
    say "speaker-test is not installed (alsa-utils)"
    return 1
}

case "${1:-status}" in
    init)   cmd_init ;;
    status) cmd_status ;;
    test)   cmd_test ;;
    server) server_state ;;
    -h|--help|help)
        sed -n 's/^# \{0,1\}//p' "$0" | sed -n '/^  copper-audio/,/^$/p'
        ;;
    *)
        say "unknown command '$1'; try: copper-audio [init|status|test|server]"
        exit 2
        ;;
esac
