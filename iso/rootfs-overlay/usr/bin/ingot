#!/bin/sh
# ingot — Copper's own package manager.
# Pages holds no packages, only flat JSON: index.json maps name -> category and
# each page gives the real URL plus sha256; the verified payload unpacks into /
# (or INGOT_ROOT for tests). Only `depends` is an array, every other field a string.
# POSIX sh / busybox ash: no local, arrays, bashisms or JSON library.

# POSIX sh only: no `local` or arrays -- dash rejects them; busybox ash runs this.

set -u

# ---- config ---------------------------------------------------------------
# /etc/ingot.conf may override the repo URL; INGOT_REPO beats both. This is
# how the gate points ingot at a scratch server, and how a user picks a mirror.
DEFAULT_REPO='https://12hrformat.github.io/copper-ingot-repo'
repo_url=$DEFAULT_REPO
[ -r /etc/ingot.conf ] && . /etc/ingot.conf
[ -n "${INGOT_REPO:-}" ] && repo_url=$INGOT_REPO

# Where packages land: / by default (the overlay); tests use a scratch tree.
ROOT=${INGOT_ROOT:-/}
MAN="$ROOT/var/lib/ingot"

# ---- privilege --------------------------------------------------------------
# install/remove/update/reinstall write into the target root, so the real /
# needs sudo; INGOT_ROOT keeps gate tests rootless in a scratch tree.
require_root() { # require_root <verb>
  [ "$ROOT" = "/" ] || return 0
  if [ "$(id -u)" -ne 0 ]; then
    echo "ingot: $1 writes into / and needs root; run it with sudo" >&2
    return 1
  fi
  return 0
}

# ---- helpers --------------------------------------------------------------

# human_mi: one-decimal MiB in integer math, so a 120M payload works in ash.
human_mi() { # human_mi <bytes>
  n=${1:-0}
  whole=$(( n / 1048576 ))
  frac=$(( (n % 1048576) * 10 / 1048576 ))
  printf '%s.%s' "$whole" "$frac"
}

# human_size <bytes> -> "255 B" / "136.3 KiB" / "119.7 MiB" (apt-style, no floats)
human_size() { # human_size <bytes>
  n=${1:-0}
  if [ "$n" -lt 1024 ]; then
    printf '%s B' "$n"
  elif [ "$n" -lt 1048576 ]; then
    v=$(( n * 10 / 1024 ))
    printf '%s.%s KiB' "$((v / 10))" "$((v % 10))"
  else
    v=$(( n * 10 / 1048576 ))
    printf '%s.%s MiB' "$((v / 10))" "$((v % 10))"
  fi
}

# draw_bar <now> <total> <speed-bytes-per-sec>  (on stderr, one \r frame)
draw_bar() {
  now=${1:-0}; total=${2:-0}; speed=${3:-0}
  [ "$total" -gt 0 ] || return 0
  [ "$now" -gt "$total" ] && now=$total
  pct=$(( now * 100 / total ))
  fill=$(( pct * 30 / 100 ))
  bar=
  i=0
  while [ "$i" -lt 30 ]; do
    if [ "$i" -lt "$fill" ]; then bar="${bar}#"; else bar="${bar}-"; fi
    i=$((i + 1))
  done
  cur=$(human_mi "$now")
  tot=$(human_mi "$total")
  kib=$(( speed / 1024 ))
  if [ "$speed" -gt 0 ]; then
    eta_s=$(( (total - now) / speed ))
    eta_m=$(( eta_s / 60 )); eta_s=$(( eta_s % 60 ))
    eta=$(printf '%02d:%02d' "$eta_m" "$eta_s")
  else
    eta="--:--"
  fi
  printf '\r  %3d%% [%s] %5s / %5s MiB  %4d KiB/s  ETA %s\033[K' \
    "$pct" "$bar" "$cur" "$tot" "$kib" "$eta" >&2
}

# download_once <file> <url> <total> -- one wget attempt; on a terminal with a
# known size it polls the growing file with stat -c %s (metadata only, never
# wc -c) to repaint a bar; otherwise it is a plain quiet wget.
download_once() { # download_once <file> <url> <total>
  _d_file=$1; _d_url=$2; _d_total=${3:-}
# Tiny packages finish before the bar ticks; logs and pipes are not terminals.
  if [ -t 2 ] && [ -n "$_d_total" ] && [ "$_d_total" -ge 1048576 ]; then
    wget -q -c -O "$_d_file" "$_d_url" &
    wpid=$!
    prev=0
    speed=0
    t_last=$(date +%s)
    while kill -0 "$wpid" 2>/dev/null; do
      sleep 1
      t_now=$(date +%s)
      now=$(stat -c %s "$_d_file" 2>/dev/null || echo 0)
      case "$now" in ''|*[!0-9]*) now=0 ;; esac
      dt=$((t_now - t_last)); [ "$dt" -lt 1 ] && dt=1
      speed=$(( (now - prev) / dt )); [ "$speed" -lt 0 ] && speed=0
      draw_bar "$now" "$_d_total" "$speed"
      prev=$now; t_last=$t_now
    done
    wait "$wpid"
    rc=$?
    done_now=$(stat -c %s "$_d_file" 2>/dev/null || echo 0)
    case "$done_now" in ''|*[!0-9]*) done_now=0 ;; esac
    draw_bar "$done_now" "$_d_total" "$speed"
    printf '\n' >&2
    return $rc
  fi
  wget -q -c -O "$_d_file" "$_d_url"
}

# ---- where the bytes come from -------------------------------------------
# The release CDN throttles, so release assets go through mirror URL PREFIXES
# first and the direct URL last: <prefix>/https://github.com/<owner>/<repo>/releases/download/<tag>/<file>.
# Only release assets are rewritten; Pages metadata is not throttled. INGOT_MIRRORS
# overrides the list ("none" disables it) so tests exercise one source at a time.
mirror_prefixes() {   # -> the mirrors to try, one per line
  if [ -n "${INGOT_MIRRORS+x}" ]; then
    case "$INGOT_MIRRORS" in
      ''|none|off|no) return 0 ;;
    esac
    printf '%s\n' $INGOT_MIRRORS
    return 0
  fi
  printf '%s\n' https://ghfast.top https://gh-proxy.com
}

dl_sources() {   # dl_sources <url> -> candidates, best first, one per line
  case "$1" in
    https://github.com/*/releases/download/*) ;;
    *) printf '%s\n' "$1"; return 0 ;;
  esac
  for _src_mp in $(mirror_prefixes); do
    printf '%s/%s\n' "$_src_mp" "$1"
  done
  printf '%s\n' "$1"
}

# dl_attempt: one source, up to five shots; remove the file first so --continue
# cannot ask a different server for bytes it never served.
dl_attempt() {
  _a_file=$1; _a_url=$2; _a_total=${3:-}; _a_want=${4:-}
  rm -f "$_a_file"
  _a_tries=5
  while [ "$_a_tries" -gt 0 ]; do
    if download_once "$_a_file" "$_a_url" "$_a_total"; then
      if [ -z "$_a_want" ]; then
        [ -s "$_a_file" ] && return 0
      elif [ "$(sha256sum "$_a_file" | awk '{print $1}')" = "$_a_want" ]; then
        return 0
      else
# A mirror can deny service but cannot inject: the page's sha256 is the authority,
# so a bad payload is discarded and the next source is tried.
        echo "ingot: $_a_url did not serve the payload the page describes" >&2
        rm -f "$_a_file"
        return 1
      fi
    fi
    _a_tries=$((_a_tries - 1))
    [ "$_a_tries" -gt 0 ] && { echo "ingot: transfer dropped; retrying ($_a_tries left)" >&2; sleep 2; }
  done
  echo "ingot: no complete transfer from $_a_url" >&2
  return 1
}

# jget/category_for/depends_of rely on one-key-per-line JSON in the files we author.
#
# wget -q -c -O works on both busybox and GNU; openssl verifies certs on the
# normal path. Say what we are doing on stderr BEFORE the network: fetch_meta's
# stdout ends in "/tmp/$name" and cmd_install captures it all for jget.
#
# The CDN drops long slow transfers, so retry with -c on each source to resume.
# Variables are prefixed because POSIX sh has no `local`: a mirror URL must not
# leak into the manifest's canonical $url/$want.
dl() { # dl <file> <url> [size] [sha256]
  dl_file=$1; dl_url=$2; dl_total=${3:-}; dl_want=${4:-}
  if [ -n "$dl_total" ]; then
    echo "ingot: downloading $(basename "$dl_url") ($(human_size "$dl_total"))" >&2
  else
    echo "ingot: fetching $dl_url" >&2
  fi
  for _dl_src in $(dl_sources "$dl_url"); do
    [ "$_dl_src" = "$dl_url" ] || echo "ingot: source $_dl_src" >&2
    dl_attempt "$dl_file" "$_dl_src" "$dl_total" "$dl_want" && return 0
  done
  echo "ingot: download failed ($dl_url)" >&2
  return 1
}

# jget: first value of "key" from our one-key-per-line flat JSON (string or int).
jget() {
  sed -n "s/^[[:space:]]*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$2" | head -n1
}

# category of a package name, from the one-entry-per-line index.
category_for() { # category_for <name> <index-file>
  sed -n "s/^[[:space:]]*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$2" | head -n1
}

# depends_of: strip the depends array to bracket contents, drop quotes, split commas.
depends_of() { # depends_of <json-file> -> names, space separated
  sed -n 's/^[[:space:]]*"depends"[[:space:]]*:[[:space:]]*\[\(.*\)\].*/\1/p' "$1" \
    | head -n1 | tr -d '"' | tr ',' ' '
}

fetch_meta() { # fetch_meta <name> -> prints its JSON file path, or nothing
  fetch_name=$1
  fetch_tmp="/tmp/$1.index.$$"
  dl "$fetch_tmp" "$repo_url/iso/copper/pkg/index.json" || return 1
  fetch_cat=$(category_for "$fetch_name" "$fetch_tmp")
  rm -f "$fetch_tmp"
  [ -n "$fetch_cat" ] || { echo "ingot: no package named '$fetch_name' in the index" >&2; return 1; }
  dl "/tmp/$fetch_name" "$repo_url/iso/copper/pkg/$fetch_cat/$fetch_name" || return 1
  echo "/tmp/$fetch_name"
}

# ---- commands -------------------------------------------------------------

cmd_install() { # cmd_install <name> [force] — force installs over an existing tree
  name=$1
  force=${2:-}
  require_root install || return 1
  if [ -f "$MAN/$name.installed" ] && [ -z "$force" ]; then
    echo "ingot: $name is already installed"
    return 0
  fi
  mkdir -p "$MAN"

  meta=$(fetch_meta "$name") || return 1
# $meta lives at /tmp/<name>; every exit path below removes it.

  url=$(jget url "$meta")
  [ -n "$url" ] || { echo "ingot: $name metadata has no 'url'" >&2; rm -f "/tmp/$name"; return 1; }
  want=$(jget sha256 "$meta")
  [ -n "$want" ] || { echo "ingot: $name metadata has no 'sha256'; refusing to install an unverified payload" >&2; rm -f "/tmp/$name"; return 1; }

# Dependencies first, depth-first; the subshell is load-bearing because POSIX sh
# has no `local` and an inline call would overwrite THIS install's name/url/want.
  deps=$(depends_of "$meta")
  if [ -n "$deps" ]; then
    echo "ingot: resolving dependencies for $name" >&2
    for dep in $deps; do
      [ -n "$dep" ] || continue
# A dependency is never forced; the installed guard must still stop recursion.
      ( force=; cmd_install "$dep" ) || { rm -f "/tmp/$name"; return 1; }
    done
  fi

# Fetch from the REAL url in the JSON; size draws a bar, sha256 is checked at
# each source so a mirror serving an error page falls through to the next one.
  payload="/tmp/$name.payload.$$"
  size=$(jget size "$meta")
  version=$(jget version "$meta")
  echo "ingot: installing $name $version" >&2
  dl "$payload" "$url" "$size" "$want" || { rm -f "/tmp/$name" "$payload"; return 1; }

# Compare the hash before touching the tree: a corrupted download must not install.
  echo "ingot: verifying $name checksum..." >&2
  got=$(sha256sum "$payload" | awk '{print $1}')
  if [ "$got" != "$want" ]; then
    echo "ingot: sha256 mismatch for $name" >&2
    echo "  metadata says $want" >&2
    echo "  download is  $got" >&2
    rm -f "/tmp/$name" "$payload"
    return 1
  fi
  [ -t 2 ] && echo "ingot: checksum ok" >&2

# Payload paths must stay inside $ROOT; refuse absolute or '..' entries.
  if tar -tzf "$payload" 2>/dev/null | grep -E '(^/|(^|/)\.\.(/|$))' -q; then
    echo "ingot: $name payload contains an absolute or '..' path; refusing" >&2
    rm -f "/tmp/$name" "$payload"
    return 1
  fi

# Manifest first, via .tmp + rename: interrupted installs must not claim success.
  {
    echo "$name|$(jget version "$meta")|$url|$want"
    tar -tzf "$payload" 2>/dev/null
  } > "$MAN/$name.installed.tmp"

# Every fallible step ran before this line, so a failed transfer cannot turn an
# update into an uninstall. Keep the old list to prune files the new payload omits.
  oldmf=
  if [ -n "$force" ] && [ -f "$MAN/$name.installed" ]; then
    oldmf="/tmp/$name.old.$$"
    cp "$MAN/$name.installed" "$oldmf" || oldmf=
  fi

  ( cd "$ROOT" && tar -xzf "$payload" ) || {
    echo "ingot: unpacking $name failed; the install was not changed" >&2
    rm -f "/tmp/$name" "$payload" "$MAN/$name.installed.tmp"
    return 1
  }

  mv "$MAN/$name.installed.tmp" "$MAN/$name.installed"

# Prune paths the old version shipped but the new one does not; leave directories
# (-F/-e keep a leading '-' literal) since another package may still use them.
  if [ -n "$oldmf" ]; then
    sed -n '2,$p' "$oldmf" | while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$line" in */) continue ;; esac
      grep -Fqx -e "$line" "$MAN/$name.installed" || rm -f "$ROOT/$line"
    done
    rm -f "$oldmf"
  fi

  rm -f "/tmp/$name" "$payload"
  echo "ingot: installed $name"

  fastfetch_branding "$name"
}

# ---- the fastfetch welcome ------------------------------------------------
# Copper's logo is a config, not a payload, so offer it once fastfetch is on disk.
# Only when BOTH ends are terminals -- scripted installs and the gate must not block.
# Files land under $ROOT, so a rootless scratch install never touches real /etc.
fastfetch_branding() { # fastfetch_branding <name>
  [ "$1" = fastfetch ] || return 0
  [ -t 0 ] && [ -t 1 ] || return 0
  # Someone who already picked a config keeps it; do not ask twice.
  [ -f "$ROOT/etc/fastfetch/config.jsonc" ] && return 0

  printf "\nhey, as of now copper linux's logo isnt in fastfetch\n" >&2
  printf 'do you wanna apply a custom config file for fastfetch? (Y/n) ' >&2

  answer=
  read -r answer || answer=

  case "$answer" in
    ''|[Yy]|[Yy][Ee][Ss]) ;;
    *)
      printf 'you are sure? its not like i want you to use my config anyways b-baka (,,>﹏<,,)\n' >&2
      return 0
      ;;
  esac

  mkdir -p "$ROOT/etc/fastfetch" "$ROOT/usr/share/copper" || return 0

# The one file here meant to be edited; the config below just points at it.
  cat > "$ROOT/usr/share/copper/fastfetch-logo.txt" <<'COPPER_LOGO'
         ____________________
       /                      \
      |  29               Cu   |
      |                        |
      |  Copper    63.546 u    |
       \______________________/
COPPER_LOGO

  cat > "$ROOT/etc/fastfetch/config.jsonc" <<'COPPER_CONFIG'
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/copper/fastfetch-logo.txt",
        "padding": {
            "top": 1,
            "left": 3,
            "right": 4
        }
    }
}
COPPER_CONFIG

  echo "ingot: applied the Copper fastfetch config" >&2
  return 0
}

cmd_remove() { # cmd_remove <name>
  name=$1
  require_root remove || return 1
  mf="$MAN/$name.installed"
  [ -f "$mf" ] || { echo "ingot: $name is not installed" >&2; return 1; }
# Skip the header; reverse order puts files before their dirs. Directories stay:
# another package may still hold files there.
  sed -n '2,$p' "$mf" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in */) continue ;; esac
    rm -f "$ROOT/$line"
  done
  rm -f "$mf"
  echo "ingot: removed $name"
}

cmd_info() { # cmd_info <name> — show the package's JSON then clean /tmp
  name=$1
  meta=
  meta=$(fetch_meta "$name") || return 1
  cat "$meta"
  rm -f "/tmp/$name"
}

cmd_search() { # cmd_search <term> — names+groups matching, straight from index.json
  term=$1
# Match names literally with -F -e: a '-' or '[' term is not a grep option or
# regex, and the fixed temp path cannot be steered by a '/'.
  tmp="/tmp/.ingot-search.$$"
  dl "$tmp" "$repo_url/iso/copper/pkg/index.json" || return 1
  grep -iF -e "$term" < "$tmp" | sed 's/[{}",:]//g' || true
  rm -f "$tmp"
}

# Manifests record name|version|url|sha256 on line 1; one sed per field.
mf_ver() { sed -n '1s/^[^|]*|\([^|]*\)|.*$/\1/p' "$1" | head -n1; }
mf_sha() { sed -n '1s/^[^|]*|[^|]*|[^|]*|\(.*\)$/\1/p' "$1" | head -n1; }

update_one() { # update_one <name> — reinstall if the repo's sha256 changed
  name=$1
  mf="$MAN/$name.installed"
  [ -f "$mf" ] || { echo "ingot: $name is not installed" >&2; return 1; }
  meta=$(fetch_meta "$name") || return 1
  want=$(jget sha256 "$meta")
  have=$(mf_sha "$mf")
  rm -f "/tmp/$name" "$meta"
  if [ "$have" = "$want" ]; then
    echo "ingot: $name is up to date"
    return 0
  fi
  echo "ingot: updating $name"
# Reinstall in place, never remove first: cmd_install verifies before writing.
  cmd_install "$name" force
}

cmd_update() { # cmd_update [name] — update one installed package, or all
  require_root update || return 1
  if [ $# -eq 1 ]; then
    update_one "$1" || return 1
    return 0
  fi
  found=0
  failed=0
  for mf in "$MAN"/*.installed; do
    [ -e "$mf" ] || continue
    found=1
# Keep going after a failure: one bad page or transfer must not strand later updates.
    update_one "$(basename "$mf" .installed)" || failed=1
  done
  [ "$found" -eq 1 ] || { echo "ingot: nothing installed"; return 0; }
  [ "$failed" -eq 0 ] || { echo "ingot: one or more packages failed to update" >&2; return 1; }
  return 0
}

cmd_reinstall() { # cmd_reinstall <name> — install again, replacing it in place
  name=$1
  require_root reinstall || return 1
# Same safety as update: force replaces in place; removing first risks an empty tree.
  cmd_install "$name" force
}

cmd_inspect() { # cmd_inspect <name> — show the installed record, not the repo page
  name=$1
  mf="$MAN/$name.installed"
  [ -f "$mf" ] || { echo "ingot: $name is not installed" >&2; return 1; }
  echo "ingot: $name $(mf_ver "$mf")"
  echo "  url:    $(sed -n '1s/^[^|]*|[^|]*|\([^|]*\)|.*$/\1/p' "$mf" | head -n1)"
  echo "  sha256: $(mf_sha "$mf")"
  echo "  files:"
  sed -n '2,$p' "$mf" | while IFS= read -r f; do
    [ -n "$f" ] && echo "    $f"
  done
}

cmd_list() { # cmd_list — installed packages and their versions
  n=0
  for mf in "$MAN"/*.installed; do
    [ -e "$mf" ] || continue
    echo "$(basename "$mf" .installed) $(mf_ver "$mf")"
    n=$((n + 1))
  done
  if [ "$n" -eq 0 ]; then echo "ingot: nothing installed"; fi
  return 0
}

# One name or several: `ingot install curl git` is both commands in sequence,
# with the index fetched per name. The loop does not stop at the first failure
# (a typo in the third of five still installs the other four) and exits nonzero
# if any failed. Prefixed vars: cmd_install leans on globals name/url/want/meta.
bulk() { # bulk <command> <name>...
  bulk_cmd=$1; shift
  bulk_ok=0
  bulk_failed=
  for bulk_name in "$@"; do
    [ -n "$bulk_name" ] || continue
    if "$bulk_cmd" "$bulk_name"; then
      bulk_ok=$((bulk_ok + 1))
    else
      bulk_failed="$bulk_failed $bulk_name"
    fi
  done
  if [ -n "$bulk_failed" ]; then
    echo "ingot: $bulk_ok of $# ok; failed:$bulk_failed" >&2
    return 1
  fi
  return 0
}

usage() {
  echo "usage: ingot <install|remove|update|reinstall|inspect|info|search|list> <name>..."
  echo "  install  <name>... fetch each one's JSON from the repo, download the"
  echo "                   real payload, verify sha256, unpack into $ROOT"
  echo "  remove   <name>... delete the files those installs recorded"
  echo "  update   [name]... reinstall any installed package whose payload"
  echo "                   changed; all of them if no name is given"
  echo "  reinstall <name>... install again, fresh (nothing removed first)"
  echo "  inspect  <name>  show the installed record: version, url, sha256, files"
  echo "  info     <name>  print the package's JSON from the repo"
  echo "  search   <term>  grep the package index"
  echo "  list             list installed packages and versions"
  echo
  echo "install/remove/update/reinstall write into / and need root:"
  echo "    sudo ingot install <name>..."
  echo "with INGOT_ROOT set to a scratch tree they run unprivileged."
  echo "repo: $repo_url"
}

[ $# -ge 1 ] || { usage; exit 1; }
case "$1" in
  install)    [ $# -ge 2 ] || { usage; exit 1; }; shift; bulk cmd_install "$@" ;;
  remove)     [ $# -ge 2 ] || { usage; exit 1; }; shift; bulk cmd_remove "$@" ;;
  reinstall)  [ $# -ge 2 ] || { usage; exit 1; }; shift; bulk cmd_reinstall "$@" ;;
  update)     if [ $# -eq 1 ]; then cmd_update; else shift; bulk cmd_update "$@"; fi ;;
  inspect)    [ $# -eq 2 ] || { usage; exit 1; }; cmd_inspect "$2" ;;
  info)       [ $# -eq 2 ] || { usage; exit 1; }; cmd_info "$2" ;;
  search)     [ $# -eq 2 ] || { usage; exit 1; }; cmd_search "$2" ;;
  list)       [ $# -eq 1 ] || { usage; exit 1; }; cmd_list ;;
  *)          usage; exit 1 ;;
esac