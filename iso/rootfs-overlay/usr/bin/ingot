#!/bin/sh
# ingot — Copper's own package manager.
#
# Packages are NOT binaries on a server with a fancy API. GitHub Pages cannot
# hold huge files comfortably, so Pages holds only the metadata, and it holds
# them as plain JSON. Every package is one file at
#
#     <repo>/iso/copper/pkg/<category>/<name>
#
# whose entire contents are JSON. The JSON carries the REAL download url of
# the payload (a Release, a CDN, anywhere big files can live) and the sha256
# the payload must match. Nothing on Pages is a package. That indirection is
# the whole design, on purpose:
#
#   1. <name> is looked up in <repo>/iso/copper/pkg/index.json (name -> category)
#   2. the package's JSON page is downloaded to /tmp/<name>
#   3. the real url and the sha256 are read out of that JSON
#   4. the payload is downloaded from the real url
#   5. its sha256 is compared to the one in the JSON — mismatch refuses
#   6. the payload is unpacked into /
#   7. the JSON in /tmp is deleted
#
# The JSON we author, so the layout is fixed and documented here, and the
# parsers below are written to that exact shape (not to JSON in general).
#
# index.json — one entry per line, so a plain sed line can find a name:
#
#   {
#     "nmap": "hacking",
#     "tree": "tools"
#   }
#
# a package page — one key per line, flat string values:
#
#   {
#     "name": "nmap",
#     "version": "7.95-1",
#     "category": "hacking",
#     "url": "https://<somewhere-big>/nmap-7.95.tar.gz",
#     "sha256": "0123...",
#     "depends": ["libpcap"]
#   }
#
# Only `depends` is an array; the rest are strings. Keep it that way when you
# author packages, or the sed parsers here will be wrong where you are not.
#
# Everything here is POSIX sh and runs under busybox ash on the live image.
# No bashisms, no curl-only flags, no JSON library: the fields above are
# one-key-per-line in the files we publish, and jget() trims that shape.

# POSIX sh note: no `local` (dash rejects it), no arrays, no bashisms. This
# must parse under /bin/sh and run under busybox ash on the live image.

set -u

# ---- config ---------------------------------------------------------------
# /etc/ingot.conf may override the repo url; INGOT_REPO beats both. This is
# how the gate test points ingot at a scratch server, and how a live user
# points it at an unofficial mirror.
DEFAULT_REPO='https://12hrformat.github.io/copper-ingot-repo'
repo_url=$DEFAULT_REPO
[ -r /etc/ingot.conf ] && . /etc/ingot.conf
[ -n "${INGOT_REPO:-}" ] && repo_url=$INGOT_REPO

# Where packages land. Empty means the real /, so a live install writes into
# the image's writable overlay. Tests set this to a scratch tree and install
# without touching the host.
ROOT=${INGOT_ROOT:-/}
MAN="$ROOT/var/lib/ingot"

# ---- privilege --------------------------------------------------------------
# install/remove/update/reinstall write into the target root. On the live
# system that root is the real /, and a normal user is not root: the elevation
# contract is `sudo ingot install ...` (sudoers + wheel are staged for exactly
# this). The gate tests point INGOT_ROOT at a scratch tree and stay rootless by
# design, so only the real / demands elevation.
require_root() { # require_root <verb>
  [ "$ROOT" = "/" ] || return 0
  if [ "$(id -u)" -ne 0 ]; then
    echo "ingot: $1 writes into / and needs root; run it with sudo" >&2
    return 1
  fi
  return 0
}

# ---- helpers --------------------------------------------------------------

# human_mi <bytes> -> "NNN.N" (one decimal, no suffix). Integer math only so
# it runs in busybox ash on a 120M payload without overflow or a float printf.
human_mi() { # human_mi <bytes>
  n=${1:-0}
  whole=$(( n / 1048576 ))
  frac=$(( (n % 1048576) * 10 / 1048576 ))
  printf '%s.%s' "$whole" "$frac"
}

# human_size <bytes> -> "255 B" / "136.3 KiB" / "119.7 MiB" (apt-style, no floats)
human_size() { # human_size <bytes>
  n=${1:-0}
  if [ "$n" -lt 1024 ]; then
    printf '%s B' "$n"
  elif [ "$n" -lt 1048576 ]; then
    v=$(( n * 10 / 1024 ))
    printf '%s.%s KiB' "$((v / 10))" "$((v % 10))"
  else
    v=$(( n * 10 / 1048576 ))
    printf '%s.%s MiB' "$((v / 10))" "$((v % 10))"
  fi
}

# draw_bar <now> <total> <speed-bytes-per-sec>  (on stderr, one \r frame)
draw_bar() {
  now=${1:-0}; total=${2:-0}; speed=${3:-0}
  [ "$total" -gt 0 ] || return 0
  [ "$now" -gt "$total" ] && now=$total
  pct=$(( now * 100 / total ))
  fill=$(( pct * 30 / 100 ))
  bar=
  i=0
  while [ "$i" -lt 30 ]; do
    if [ "$i" -lt "$fill" ]; then bar="${bar}#"; else bar="${bar}-"; fi
    i=$((i + 1))
  done
  cur=$(human_mi "$now")
  tot=$(human_mi "$total")
  kib=$(( speed / 1024 ))
  if [ "$speed" -gt 0 ]; then
    eta_s=$(( (total - now) / speed ))
    eta_m=$(( eta_s / 60 )); eta_s=$(( eta_s % 60 ))
    eta=$(printf '%02d:%02d' "$eta_m" "$eta_s")
  else
    eta="--:--"
  fi
  printf '\r  %3d%% [%s] %5s / %5s MiB  %4d KiB/s  ETA %s\033[K' \
    "$pct" "$bar" "$cur" "$tot" "$kib" "$eta" >&2
}

# download_once <file> <url> <total> -- one wget attempt. On a terminal with a
# known size it runs wget in the background and repaints a pacman-style bar
# from the growing file. Polling uses stat -c %s (busybox and GNU) which is
# metadata only -- NOT wc -c, which reads the whole payload every second, and
# NOT wc -c's `SIZE filename` output shape. Off a terminal, or with no size
# known, it is a plain quiet wget.
download_once() { # download_once <file> <url> <total>
  file=$1; url=$2; total=${3:-}
  # Bar only for real payloads on a real terminal: tiny packages (libpcap 136K,
  # tcpdump 533K) finish faster than the bar can tick, and logs/scripts are
  # quiet pipes, not terminals.
  if [ -t 2 ] && [ -n "$total" ] && [ "$total" -ge 1048576 ]; then
    wget -q -c -O "$file" "$url" &
    wpid=$!
    prev=0
    speed=0
    t_last=$(date +%s)
    while kill -0 "$wpid" 2>/dev/null; do
      sleep 1
      t_now=$(date +%s)
      now=$(stat -c %s "$file" 2>/dev/null || echo 0)
      case "$now" in ''|*[!0-9]*) now=0 ;; esac
      dt=$((t_now - t_last)); [ "$dt" -lt 1 ] && dt=1
      speed=$(( (now - prev) / dt )); [ "$speed" -lt 0 ] && speed=0
      draw_bar "$now" "$total" "$speed"
      prev=$now; t_last=$t_now
    done
    wait "$wpid"
    rc=$?
    done_now=$(stat -c %s "$file" 2>/dev/null || echo 0)
    case "$done_now" in ''|*[!0-9]*) done_now=0 ;; esac
    draw_bar "$done_now" "$total" "$speed"
    printf '\n' >&2
    return $rc
  fi
  wget -q -c -O "$file" "$url"
}

# fetch url -> file. busybox wget and GNU wget both accept -O and -q.
# busybox wget's openssl helper path verifies certificates (the image ships
# openssl since 2026-10-10); only the internal-TLS fallback skips that, and
# the helper is the path a normal image takes.
#
# Say what we are doing before touching the network -- a multi-tens-of-MB
# payload from the release CDN looks like a hang when the only output line is
# the trailing "installed". The note goes to stderr, not stdout: fetch_meta
# ends with `echo "/tmp/$name"` and cmd_install captures ALL of its stdout via
# `meta=$(fetch_meta ...)` -- a stdout note would land in the package meta and
# break jget. stderr is the notification channel here.
#
# The release CDN drops long slow transfers ("connection closed prematurely"
# from busybox, i.e. the server closed the socket before content-length bytes
# arrived). One wget shot therefore fails most of the time on a 120MB payload;
# retry a few times with -c so each attempt resumes the bytes already pulled
# instead of restarting. busybox wget checks that the server honored the Range
# header and starts over itself when it did not.
dl() { # dl <file> <url> [size]
  file=$1; url=$2; total=${3:-}
  if [ -n "$total" ]; then
    echo "ingot: downloading $(basename "$url") ($(human_size "$total"))" >&2
  else
    echo "ingot: fetching $url" >&2
  fi
  tries=5
  while [ "$tries" -gt 0 ]; do
    if download_once "$file" "$url" "$total"; then
      [ -s "$file" ] && return 0
    fi
    tries=$((tries - 1))
    [ "$tries" -gt 0 ] && { echo "ingot: transfer dropped; retrying ($tries left)" >&2; sleep 2; }
  done
  echo "ingot: download failed ($url)" >&2
  return 1
}

# jget <key> <json-file> -> the value of "key": value (first match, no \n).
# Works because our JSON is one key per line with flat values. Accepts both
# "key": "string" and "key": 123456 (size is an unquoted integer).
jget() {
  sed -n "s/^[[:space:]]*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$2" | head -n1
}

# category of a package name, from the one-entry-per-line index.
category_for() { # category_for <name> <index-file>
  sed -n "s/^[[:space:]]*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$2" | head -n1
}

# the depends line -> names, space separated. "depends": ["a","b"] is an
# array, so this reaches past jget: strip to the bracket contents, drop
# quotes, split on commas.
depends_of() { # depends_of <json-file> -> names, space separated
  sed -n 's/^[[:space:]]*"depends"[[:space:]]*:[[:space:]]*\[\(.*\)\].*/\1/p' "$1" \
    | head -n1 | tr -d '"' | tr ',' ' '
}

fetch_meta() { # fetch_meta <name> -> prints its JSON file path, or nothing
  fetch_name=$1
  fetch_tmp="/tmp/$1.index.$$"
  dl "$fetch_tmp" "$repo_url/iso/copper/pkg/index.json" || return 1
  fetch_cat=$(category_for "$fetch_name" "$fetch_tmp")
  rm -f "$fetch_tmp"
  [ -n "$fetch_cat" ] || { echo "ingot: no package named '$fetch_name' in the index" >&2; return 1; }
  dl "/tmp/$fetch_name" "$repo_url/iso/copper/pkg/$fetch_cat/$fetch_name" || return 1
  echo "/tmp/$fetch_name"
}

# ---- commands -------------------------------------------------------------

cmd_install() { # cmd_install <name> [force] — force installs over an existing tree
  name=$1
  force=${2:-}
  require_root install || return 1
  if [ -f "$MAN/$name.installed" ] && [ -z "$force" ]; then
    echo "ingot: $name is already installed"
    return 0
  fi
  mkdir -p "$MAN"

  meta=$(fetch_meta "$name") || return 1
  # $meta lives at /tmp/<name> per the design; every exit path below removes
  # it, so a half-finished install cannot leave a package page behind.

  url=$(jget url "$meta")
  [ -n "$url" ] || { echo "ingot: $name metadata has no 'url'" >&2; rm -f "/tmp/$name"; return 1; }
  want=$(jget sha256 "$meta")
  [ -n "$want" ] || { echo "ingot: $name metadata has no 'sha256'; refusing to install an unverified payload" >&2; rm -f "/tmp/$name"; return 1; }

  # Dependencies first, depth-first. Recursion is fine: the index is small
  # and the already-installed check above stops the loop. The subshell is
  # load-bearing: POSIX sh here has no `local`, so calling cmd_install inline
  # would let the dependency's fetch overwrite THIS install's name/url/want/
  # meta globals and the outer install would silently install the dep again
  # under the dep's own name. A subshell keeps the outer frame intact --
  # files churn on disk (fine, that is the point), variables do not.
  deps=$(depends_of "$meta")
  if [ -n "$deps" ]; then
    echo "ingot: resolving dependencies for $name" >&2
    for dep in $deps; do
      [ -n "$dep" ] || continue
      # A dependency is never force-installed: force is this call's business,
      # and the already-installed guard above still has to stop the recursion.
      ( force=; cmd_install "$dep" ) || { rm -f "/tmp/$name"; return 1; }
    done
  fi

  # The real payload, from the REAL url in the JSON. A size in the page makes
  # dl draw a live progress bar on a terminal (pacman-style); without it the
  # same download just runs quietly.
  payload="/tmp/$name.payload.$$"
  size=$(jget size "$meta")
  version=$(jget version "$meta")
  echo "ingot: installing $name $version" >&2
  dl "$payload" "$url" "$size" || { rm -f "/tmp/$name" "$payload"; return 1; }

  # The whole point of carrying the hash: a corrupted or replaced download
  # must not install. Compare before touching the tree.
  echo "ingot: verifying $name checksum..." >&2
  got=$(sha256sum "$payload" | awk '{print $1}')
  if [ "$got" != "$want" ]; then
    echo "ingot: sha256 mismatch for $name" >&2
    echo "  metadata says $want" >&2
    echo "  download is  $got" >&2
    rm -f "/tmp/$name" "$payload"
    return 1
  fi
  [ -t 2 ] && echo "ingot: checksum ok" >&2

  # Payload tar paths must stay inside the target root. An absolute path or
  # a .. entry would walk out of it; refuse before unpacking.
  if tar -tzf "$payload" 2>/dev/null | grep -E '(^/|(^|/)\.\.(/|$))' -q; then
    echo "ingot: $name payload contains an absolute or '..' path; refusing" >&2
    rm -f "/tmp/$name" "$payload"
    return 1
  fi

  # Manifest before unpack: the exact file list, plus the record that will
  # make `remove` possible. Written to a .tmp and renamed so an interrupted
  # install cannot claim to be installed.
  {
    echo "$name|$(jget version "$meta")|$url|$want"
    tar -tzf "$payload" 2>/dev/null
  } > "$MAN/$name.installed.tmp"

  # A force install (update/reinstall) replaces the package in place. Every step
  # that can fail -- the page fetch, the download, the sha256 check, the tar
  # listing just now -- has run before this line and none of them touched the old
  # tree, so a failed transfer can no longer turn an update into an uninstall.
  # Keep the old file list to prune whatever the new payload does not ship.
  oldmf=
  if [ -n "$force" ] && [ -f "$MAN/$name.installed" ]; then
    oldmf="/tmp/$name.old.$$"
    cp "$MAN/$name.installed" "$oldmf" || oldmf=
  fi

  ( cd "$ROOT" && tar -xzf "$payload" ) || {
    echo "ingot: unpacking $name failed; the install was not changed" >&2
    rm -f "/tmp/$name" "$payload" "$MAN/$name.installed.tmp"
    return 1
  }

  mv "$MAN/$name.installed.tmp" "$MAN/$name.installed"

  # Drop files the old version listed and the new one does not, or an update
  # leaves the previous version's files behind. Directories are left alone, as
  # `remove` does: another package may still hold files in them. -F and -e keep
  # a recorded path that starts with '-' a literal, not a grep option.
  if [ -n "$oldmf" ]; then
    sed -n '2,$p' "$oldmf" | while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$line" in */) continue ;; esac
      grep -Fqx -e "$line" "$MAN/$name.installed" || rm -f "$ROOT/$line"
    done
    rm -f "$oldmf"
  fi

  rm -f "/tmp/$name" "$payload"
  echo "ingot: installed $name"

  fastfetch_branding "$name"
}

# ---- the fastfetch welcome ------------------------------------------------
#
# fastfetch carries a logo for the distros it knows and Copper is not one of
# them, so a fresh install shows a generic penguin. Copper's own logo is a
# config, not part of the payload, so the offer is made here once the binary
# is actually on disk: Enter takes the default (Y), a no gets a sulk.
#
# The offer only happens when BOTH ends are a terminal. A scripted or piped
# install -- and the gate test, which captures stdout -- must never block on
# a read with nobody there to answer it. The files land under $ROOT, so a
# rootless test that points INGOT_ROOT at a scratch tree writes there and
# never near the real /etc.
fastfetch_branding() { # fastfetch_branding <name>
  [ "$1" = fastfetch ] || return 0
  [ -t 0 ] && [ -t 1 ] || return 0
  # Someone who already picked a config keeps it; do not ask twice.
  [ -f "$ROOT/etc/fastfetch/config.jsonc" ] && return 0

  printf "\nhey, as of now copper linux's logo isnt in fastfetch\n" >&2
  printf 'do you wanna apply a custom config file for fastfetch? (Y/n) ' >&2

  answer=
  read -r answer || answer=

  case "$answer" in
    ''|[Yy]|[Yy][Ee][Ss]) ;;
    *)
      printf 'you are sure? its not like i want you to use my config anyways b-baka (,,>﹏<,,)\n' >&2
      return 0
      ;;
  esac

  mkdir -p "$ROOT/etc/fastfetch" "$ROOT/usr/share/copper" || return 0

  # Replace this art with Copper's own; it is the one thing here meant to be
  # edited, and the config below only points at it.
  cat > "$ROOT/usr/share/copper/fastfetch-logo.txt" <<'COPPER_LOGO'
         ____________________
       /                      \
      |  29               Cu   |
      |                        |
      |  Copper    63.546 u    |
       \______________________/
COPPER_LOGO

  cat > "$ROOT/etc/fastfetch/config.jsonc" <<'COPPER_CONFIG'
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/copper/fastfetch-logo.txt",
        "padding": {
            "top": 1,
            "left": 3,
            "right": 4
        }
    }
}
COPPER_CONFIG

  echo "ingot: applied the Copper fastfetch config" >&2
  return 0
}

cmd_remove() { # cmd_remove <name>
  name=$1
  require_root remove || return 1
  mf="$MAN/$name.installed"
  [ -f "$mf" ] || { echo "ingot: $name is not installed" >&2; return 1; }
  # Skip the header line (the first line, name|version|url|sha256); the rest
  # are payload paths. Reverse purpose: files before the dirs that held them.
  # tar lists dirs with a trailing slash; those are left, along with any dir
  # that still has other packages' files in it.
  sed -n '2,$p' "$mf" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in */) continue ;; esac
    rm -f "$ROOT/$line"
  done
  rm -f "$mf"
  echo "ingot: removed $name"
}

cmd_info() { # cmd_info <name> — show the package's JSON then clean /tmp
  name=$1
  meta=
  meta=$(fetch_meta "$name") || return 1
  cat "$meta"
  rm -f "/tmp/$name"
}

cmd_search() { # cmd_search <term> — names+groups matching, straight from index.json
  term=$1
  # A package name is not a pattern: match it literally (-F) and pass it with
  # -e, so a term that starts with '-' is a search string and not a grep option.
  # A regex grep also dies on a term like '[' that is not a valid expression,
  # printing a grep error where a result belongs. The temp name is fixed, so a
  # term containing '/' cannot steer the path.
  tmp="/tmp/.ingot-search.$$"
  dl "$tmp" "$repo_url/iso/copper/pkg/index.json" || return 1
  grep -iF -e "$term" < "$tmp" | sed 's/[{}",:]//g' || true
  rm -f "$tmp"
}

# Installed manifests record name|version|url|sha256 on their first line, so
# the recorded version and sha256 come straight out with one sed per field.
mf_ver() { sed -n '1s/^[^|]*|\([^|]*\)|.*$/\1/p' "$1" | head -n1; }
mf_sha() { sed -n '1s/^[^|]*|[^|]*|[^|]*|\(.*\)$/\1/p' "$1" | head -n1; }

update_one() { # update_one <name> — reinstall if the repo's sha256 changed
  name=$1
  mf="$MAN/$name.installed"
  [ -f "$mf" ] || { echo "ingot: $name is not installed" >&2; return 1; }
  meta=$(fetch_meta "$name") || return 1
  want=$(jget sha256 "$meta")
  have=$(mf_sha "$mf")
  rm -f "/tmp/$name" "$meta"
  if [ "$have" = "$want" ]; then
    echo "ingot: $name is up to date"
    return 0
  fi
  echo "ingot: updating $name"
  # Install straight over the old tree instead of removing first: cmd_install
  # fetches and verifies the new payload before it writes anything, so a bad
  # transfer cannot delete a working install (bug 27). The old version is only
  # replaced once the new payload is proven and unpacked.
  cmd_install "$name" force
}

cmd_update() { # cmd_update [name] — update one installed package, or all
  require_root update || return 1
  if [ $# -eq 1 ]; then
    update_one "$1" || return 1
    return 0
  fi
  found=0
  failed=0
  for mf in "$MAN"/*.installed; do
    [ -e "$mf" ] || continue
    found=1
    # Keep going after a failure: one package whose page was pulled from the
    # repo, or one dropped transfer, must not strand every later update.
    update_one "$(basename "$mf" .installed)" || failed=1
  done
  [ "$found" -eq 1 ] || { echo "ingot: nothing installed"; return 0; }
  [ "$failed" -eq 0 ] || { echo "ingot: one or more packages failed to update" >&2; return 1; }
  return 0
}

cmd_reinstall() { # cmd_reinstall <name> — install again, replacing it in place
  name=$1
  require_root reinstall || return 1
  # Same safety as update: removing first would leave nothing behind when the
  # fresh payload cannot be fetched. force installs over the existing tree.
  cmd_install "$name" force
}

cmd_inspect() { # cmd_inspect <name> — show the installed record, not the repo page
  name=$1
  mf="$MAN/$name.installed"
  [ -f "$mf" ] || { echo "ingot: $name is not installed" >&2; return 1; }
  echo "ingot: $name $(mf_ver "$mf")"
  echo "  url:    $(sed -n '1s/^[^|]*|[^|]*|\([^|]*\)|.*$/\1/p' "$mf" | head -n1)"
  echo "  sha256: $(mf_sha "$mf")"
  echo "  files:"
  sed -n '2,$p' "$mf" | while IFS= read -r f; do
    [ -n "$f" ] && echo "    $f"
  done
}

cmd_list() { # cmd_list — installed packages and their versions
  n=0
  for mf in "$MAN"/*.installed; do
    [ -e "$mf" ] || continue
    echo "$(basename "$mf" .installed) $(mf_ver "$mf")"
    n=$((n + 1))
  done
  if [ "$n" -eq 0 ]; then echo "ingot: nothing installed"; fi
  return 0
}

# One name or several. `ingot install curl git` is the same as both commands
# run one after the other, which is what it means to a person typing it: the
# table in the repo is flat and the index is fetched once per name either way.
# The loop deliberately does not stop at the first failure -- a typo in the
# third of five names should still install the other four -- and the exit
# status is nonzero if any of them failed, so `ingot install a b && ...` still
# means what it looks like.
#
# The variables are prefixed because POSIX sh here has no `local`, and
# cmd_install is a function that leans on globals (name/url/want/meta) for the
# package it is installing; a bare `name` in this loop would overwrite the one
# it is working with.
bulk() { # bulk <command> <name>...
  bulk_cmd=$1; shift
  bulk_ok=0
  bulk_failed=
  for bulk_name in "$@"; do
    [ -n "$bulk_name" ] || continue
    if "$bulk_cmd" "$bulk_name"; then
      bulk_ok=$((bulk_ok + 1))
    else
      bulk_failed="$bulk_failed $bulk_name"
    fi
  done
  if [ -n "$bulk_failed" ]; then
    echo "ingot: $bulk_ok of $# ok; failed:$bulk_failed" >&2
    return 1
  fi
  return 0
}

usage() {
  echo "usage: ingot <install|remove|update|reinstall|inspect|info|search|list> <name>..."
  echo "  install  <name>... fetch each one's JSON from the repo, download the"
  echo "                   real payload, verify sha256, unpack into $ROOT"
  echo "  remove   <name>... delete the files those installs recorded"
  echo "  update   [name]... reinstall any installed package whose payload"
  echo "                   changed; all of them if no name is given"
  echo "  reinstall <name>... install again, fresh (nothing removed first)"
  echo "  inspect  <name>  show the installed record: version, url, sha256, files"
  echo "  info     <name>  print the package's JSON from the repo"
  echo "  search   <term>  grep the package index"
  echo "  list             list installed packages and versions"
  echo
  echo "install/remove/update/reinstall write into / and need root:"
  echo "    sudo ingot install <name>..."
  echo "with INGOT_ROOT set to a scratch tree they run unprivileged."
  echo "repo: $repo_url"
}

[ $# -ge 1 ] || { usage; exit 1; }
case "$1" in
  install)    [ $# -ge 2 ] || { usage; exit 1; }; shift; bulk cmd_install "$@" ;;
  remove)     [ $# -ge 2 ] || { usage; exit 1; }; shift; bulk cmd_remove "$@" ;;
  reinstall)  [ $# -ge 2 ] || { usage; exit 1; }; shift; bulk cmd_reinstall "$@" ;;
  update)     if [ $# -eq 1 ]; then cmd_update; else shift; bulk cmd_update "$@"; fi ;;
  inspect)    [ $# -eq 2 ] || { usage; exit 1; }; cmd_inspect "$2" ;;
  info)       [ $# -eq 2 ] || { usage; exit 1; }; cmd_info "$2" ;;
  search)     [ $# -eq 2 ] || { usage; exit 1; }; cmd_search "$2" ;;
  list)       [ $# -eq 1 ] || { usage; exit 1; }; cmd_list ;;
  *)          usage; exit 1 ;;
esac