#!/bin/sh
# Copper Linux -- find the interface worth handing to DHCP, and run the client on it.
# The systemd counterpart of copper-init's bring_up_network(): ask sysfs which
# interface is real, then start udhcpc on it. Wired only -- no wireless stack.
#
# Why a helper, not a literal in the unit: the unit used to say
#     ExecStart=/sbin/udhcpc -i eth0 -b -p /run/udhcpc.eth0.pid
# and eth0 is a NAME, not a fact (only the first NIC the kernel enumerates).
# A box with no wired NIC had no eth0, udhcpc exited non-zero, and with no Restart=
# [FAILED] landed on the tty the wizard was drawing its form on (bug 47).
#
# Link-layer types are the ARPHRD_* numbers from linux/if_arp.h: ABI, printed in
# decimal by /sys/class/net/<if>/type. POSIX sh, not bash: busybox ash has no
# local, arrays or [[ ]] (see assert_shell_scripts_parse() in iso/build.sh).

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

# To the screen and serial port. Quiet (the normal splash entry) mutes the screen
# half so a stray line cannot land behind the animation or push the wizard's form
# down; the serial log keeps every line for a post-mortem.
QUIET=0
if read -r cmdline < /proc/cmdline 2>/dev/null; then
    case " $cmdline " in
        *" quiet "*) QUIET=1 ;;
    esac
fi
say() {
    [ "$QUIET" = 1 ] || echo "copper-dhcp: $*"
    if [ -c /dev/ttyS0 ]; then
        echo "copper-dhcp: $*" > /dev/ttyS0 2>/dev/null || true
    fi
}

# ARPHRD_ETHER, the wired link layer.
ether_type=1

# The link-layer type of an interface, or nothing if sysfs has no answer.
iface_type() {
    cat "/sys/class/net/$1/type" 2>/dev/null
}

# The first interface with the wanted link-layer type -- not the first name:
# built-in drivers invent sit0-like tunnels before the real NIC probes, and DHCP
# on a tunnel broadcasts DISCOVER into nowhere. The type decides, as in copper-init.c.
find_iface() {
    want_type=$1
    for d in /sys/class/net/*; do
        [ -e "$d" ] || continue
        n=${d##*/}
        [ "$n" = "lo" ] && continue
        [ "$(iface_type "$n")" = "$want_type" ] || continue
        echo "$n"
        return 0
    done
    return 1
}

# The interface to use: the first wired NIC.
pick_iface() {
    find_iface "$ether_type"
}

# A freshly attached NIC can land a moment after systemd starts, so wait two
# whole seconds (busybox sleep truncates fractions) like copper-init does -- a
# VMware guest's NIC can arrive late.
tries_left=2
while [ "$tries_left" -gt 0 ]; do
    ifname=$(pick_iface) || ifname=""
    [ -n "$ifname" ] && break
    ifname=""
    tries_left=$((tries_left - 1))
    [ "$tries_left" -gt 0 ] && sleep 1
done

# No interface is not a failure: keep booting, and keep [FAILED] off the wizard's tty.
if [ -z "$ifname" ]; then
    say "no network interface, skipping DHCP"
    exit 0
fi

# No /dev/eth0 test here: network interfaces are sockets, not devtmpfs nodes. The
# old always-false test silently disabled DHCP on every systemd boot.

# Raise the link before the client, best effort: the lease script's deconfig
# branch does it too, and udhcpc does itself, so failure is not fatal.
ip link set dev "$ifname" up 2>/dev/null || true

say "$ifname is up, asking DHCP for an address"

# exec so the unit IS udhcpc and signals reach the client. -f is load-bearing:
# under systemd, -b's parent exits after the lease and KillMode=control-group
# kills the daemonised child, so renewal stops. -f keeps the client in the
# foreground for the boot, so a cable plugged in later still gets a lease.
exec /sbin/udhcpc -i "$ifname" -s /usr/share/udhcpc/default.script \
    -f -p "/run/udhcpc.$ifname.pid"
