# Copper Linux — DHCP client for the machine's real interface.
# Same busybox udhcpc copper-init used to launch, as a unit: migration moves PID 1,
# not the network stack. networkd would be a second change riding along with it.
#
# Type=simple with -f (set by the helper): udhcpc gets a lease and stays in the
# foreground renewing it, and the unit OWNS the client. With -b the short-lived
# parent exited, systemd called the unit finished, and KillMode=control-group
# killed the daemonised child; -f makes the unit's main process the lease's life.
#
# No Restart= on purpose: every failed start prints [FAILED] on the tty the wizard
# is drawing on (bug 47). -f means "no lease yet" is not "gives up".
# After=network.target is not enough -- nothing defines it here -- so the unit
# waits for udev to settle, making "the first real interface" a stable answer.
[Unit]
Description=Copper DHCP client (busybox udhcpc)
# No Documentation= here, and that is a decision: this image ships no man and no
# man pages (the gui closure pulls in no man-db), so man:udhcpc(1) points at a page
# nothing can open, just like the removed file: lines. systemd-analyze says so
# ("Can't show udhcpc(1)") on every build.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=copper-console.service

[Service]
Type=simple
# PATH matters: udhcpc passes its environment to the lease script, which runs
# ip(8). The helper sets it for itself; this copy gets it to the script either way.
Environment=PATH=/sbin:/usr/sbin:/bin:/usr/bin
# The interface is NOT named here. This unit used to say
#     ExecStart=/sbin/udhcpc -i eth0 -b -p /run/udhcpc.eth0.pid
# and eth0 is a name, not a fact: a box with no wired NIC has no eth0, udhcpc
# exits non-zero and -- with no Restart= -- boots with no network. The helper does
# what copper-init does: ask sysfs for a real wired link, wait, exec udhcpc on it.
# 99-default.link keeps the kernel's names, so it finds eth0 without depending
# on that being true.
ExecStart=/usr/bin/copper-dhcp
# Stop with the unit: -f makes this the client, not an orphaned daemon.
KillMode=mixed
RemainAfterExit=no

[Install]
WantedBy=copper.target
