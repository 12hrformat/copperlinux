# Copper Linux — hand the boot splash back to the console.
# After the splash and network (the no-systemd init used the DHCP beat to hold the
# splash up) and before anything that draws on tty1 for real: wizard, shell, clear.
# ExecStart is a helper, not `plymouth --quit`: quitting when the network came up
# cut the 150-frame animation at frame 20. The helper reads frame_count and the
# refresh rate from the theme, waits against copper-splash-show's stamp, then
# quits and waits for the daemon to release the VT -- so the wizard draws after the
# last frame, not over the middle.
# The clear helper is NOT in Before=: it erases boot text ahead of sysinit, before
# the splash is even up, and adding that edge closes an unbootable cycle.
# Without this unit plymouthd would run until shutdown, hiding the wizard's tty.
[Unit]
Description=Copper Linux boot splash -- hand the console back
DefaultDependencies=no
After=copper-plymouth.service copper-network.service
Before=copper-firstboot.service copper-console.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/copper-splash-quit

[Install]
WantedBy=copper.target
