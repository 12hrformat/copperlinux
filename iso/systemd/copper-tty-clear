#!/bin/sh
# Wipe the console and leave the cursor at the top left.
# The kernel's own text stays on tty1, and systemd paints [ OK ] / [ FAILED ] at
# the current row, so a boot shows two half-screens fighting. One erase before
# the first status line fixes it; this is the body of copper-tty-clear.service.
#
# The escape sequence:
#   \033[r  reset the scrolling region (DECSTBM), so the erase covers the screen
#           and \033[H homes to the top, not the top of a leftover region.
#   \033[2J  erase the screen; \033[3J drop scrollback where supported, so a
#           user cannot scroll up into kernel text; \033[H home the cursor.
# Written to /dev/tty1, not stdout (the journal), with no TTYPath=: a console
# that cannot be opened is one that cannot fail (serial-only boot, no tty).
# `|| exit 0` and SuccessExitStatus keep that from ever stopping a boot.
printf '\033[r\033[2J\033[3J\033[H' > /dev/tty1 2>/dev/null || exit 0
exit 0
