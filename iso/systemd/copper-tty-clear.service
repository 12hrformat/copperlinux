# Copper Linux — clear the console once, before the boot messages start.
# The kernel's text stays on tty1 and systemd paints [ OK ] / [ FAILED ] at the
# current row, so the screen shows scrollback above the status lines. This oneshot
# erases in the window between "kernel finished" and "first thing prints".
# Before= sysinit.target, udevd, firstboot and console; no Requires/Wants, since
# this is cosmetic and must never hold a real unit back. oneshot with no
# RemainAfterExit: it does its work, is gone, and a later boot does it again.
#
[Unit]
Description=Copper console clear (erase the kernel's boot text)
DefaultDependencies=no
# BEFORE sysinit.target, not after: the first status line is a sysinit unit's.
#
# After=sysinit.target is an ORDERING CYCLE and the boot does not survive it:
# udevd's own unit carries Before=sysinit.target, so these close a loop:
#   sysinit.target -> copper-tty-clear.service -> systemd-udevd.service
#                  -> sysinit.target
# systemd's "Found ordering cycle ... unfixable cyclic ordering dependency"
# fails the INITIAL TRANSACTION -- no boot, not a degraded one.
# DefaultDependencies=no drops the implicit Requires/After on sysinit.target,
# so only the ordering written here applies.
Before=sysinit.target systemd-udevd.service copper-firstboot.service copper-console.service
# No Requires/Wants of its own (it is in copper.target.wants, so it does run) and
# the burst limit is off, so it cannot hold a real unit back or take one down.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/copper-tty-clear
# No TTYPath=: systemd opening the tty before the script adds a way to FAIL with a
# [ FAILED ] line on the very screen this unit cleans. The script treats an
# unopenable tty as "nothing to clear" and exits 0; serial-only must still boot.
SuccessExitStatus=0 1

[Install]
WantedBy=copper.target
