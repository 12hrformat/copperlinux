# Copper Linux — the console: the wizard's shell, on tty1.
# copper-init as a service instead of PID 1: the smallest honest migration step.
# --console keeps the hard, already-right parts: account drop (the shell runs as
# the wizard's user, or Firefox refuses to start), controlling tty (so /dev/tty
# works), and the respawn loop (logout returns the same shell/session).
# Everything a real PID 1 does -- mounts, power, hostname, DHCP, seatd, udev
# seeding, reaping -- moves to systemd and the units here (see console_main()).
#
# Type=simple, Restart=always: the inner loop respawns the SHELL; systemd respawns
# --console itself only if the process died. Two layers, not redundant.
[Unit]
Description=Copper console (login shell on tty1)
# Wants=, not Requires=, for firstboot and seatd: After= does ordering, and a
# failed wizard or seatd must not take the only way in -- Requires= turns either
# into a black tty with no login or diagnosis (SYSTEMD-MIGRATION.md).
Wants=copper-firstboot.service
After=copper-firstboot.service copper-seatd.service copper-network.service
# Conflicts with getty@tty1: two writers on one tty is the two-shells bug in unit form.
Conflicts=getty@tty1.service
Before=getty.target
# Switch off the restart burst limit here, in [Unit] where systemd 255 reads it
# (it moved from [Service] in systemd 230). Misplaced, it is silently ignored and
# the tty goes dark after five fast restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/copper-init --console
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=no
# Do not thrash, but always come back.
Restart=always
RestartSec=1s
# Bound the stop hard: the desktop lives in this cgroup, and the default
# KillMode=control-group SIGTERMs everyone then waits the full 90 s TimeoutStopSec.
# KillMode=mixed signals only the main process, then SIGKILLs the rest after 5 s.
# --console has no SIGTERM handler (power handlers belong to PID 1), so it exits
# at once. SendSIGKILL=yes is spelled out so a global "no" cannot turn bound to wait.
KillMode=mixed
SendSIGKILL=yes
TimeoutStopSec=5s

[Install]
WantedBy=copper.target
