# Copper Linux -- VMware guest tools.
# Under systemd, what copper-init's start_vmtools() did: run vmtoolsd as root so
# its plugins can talk to the host. The resolution plugin is the point:
# resolutionKMS follows the host's SetResolution hint, so the guest console tracks
# the VMware window; without it the desktop stays at the firmware's pixel count.
# ConditionVirtualization=vmware keeps this off bare metal and other hypervisors.
# Restart is bounded, as in copper-seatd.service: [FAILED] over the wizard's form.
[Unit]
Description=Copper VMware guest tools (display autofit)
ConditionVirtualization=vmware
ConditionPathExists=|/usr/bin/vmtoolsd
ConditionPathExists=|/usr/sbin/vmtoolsd
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=copper-console.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
# Both paths have been used by the package; exec keeps vmtoolsd as the unit's process.
ExecStart=/bin/sh -c 'for p in /usr/bin/vmtoolsd /usr/sbin/vmtoolsd; do \
    [ -x "$p" ] && exec "$p"; done; \
    echo "copper-vmtools: no vmtoolsd binary at /usr/bin/vmtoolsd or /usr/sbin/vmtoolsd" >&2; \
    exit 127'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=copper.target
