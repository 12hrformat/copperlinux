#!/bin/sh
# Copper Linux -- compressed swap in RAM, set up before anything heavy starts.
# The live image has no swap: /init's overlay is a tmpfs capped at half of RAM,
# and niri + kitty + a browser want the other half. Allocation bursts made the
# kernel reclaim and the session stall ("niri froze", blamed on too little RAM).
# zram is RAM shaped like a disk: pages are compressed (lzo-rle, ~2-3x for the
# text/zero pages swap mostly holds), so swapping costs CPU, not I/O.
# Size: half of RAM clamped to [256 MiB, 4 GiB] -- enough for a burst without
# competing with the working set. POSIX sh; busybox ash has no local/arrays
# (see assert_shell_scripts_parse() in iso/build.sh).

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

Z=/sys/block/zram0
if [ ! -e "$Z" ]; then
# Not fatal: a kernel without zram still boots, it just has no swap; log to serial.
    echo "copper-zram: no /dev/zram0, the kernel has no zram" >&2
    exit 0
fi

mem_kb=$(sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
[ -n "$mem_kb" ] || mem_kb=0
size_mb=$((mem_kb / 2 / 1024))
[ "$size_mb" -lt 256 ] && size_mb=256
[ "$size_mb" -gt 4096 ] && size_mb=4096

# Initialise once; the disksize guard also makes a manual re-run safe.
cur=$(cat "$Z/disksize" 2>/dev/null || echo 0)
if [ "$cur" = 0 ]; then
# Pick a compressor the kernel carries: lzo-rle, then lz4 or zstd as fallbacks.
    algos=$(cat "$Z/comp_algorithm" 2>/dev/null || echo "")
    comp=""
    case "$algos" in
        *lzo-rle*) comp=lzo-rle ;;
        *lz4*)     comp=lz4 ;;
        *zstd*)    comp=zstd ;;
    esac
    if [ -n "$comp" ]; then
        echo "$comp" > "$Z/comp_algorithm" 2>/dev/null || true
    fi
    if ! echo "${size_mb}M" > "$Z/disksize"; then
        echo "copper-zram: could not set zram0 disksize" >&2
        exit 1
    fi
fi

swapped_on=0
if ! grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null; then
    swapped_on=1
# A blank block device has no swap signature, so mkswap after disksize and before
# swapon -- its absence once made this unit fail on the first real ISO.
    if command -v mkswap >/dev/null 2>&1; then
        mkswap /dev/zram0 >/dev/null || {
            echo "copper-zram: mkswap /dev/zram0 failed" >&2
            exit 1
        }
    elif /bin/busybox --list 2>/dev/null | grep -qx mkswap; then
        /bin/busybox mkswap /dev/zram0 >/dev/null || {
            echo "copper-zram: busybox mkswap /dev/zram0 failed" >&2
            exit 1
        }
    else
        echo "copper-zram: no mkswap (neither util-linux nor busybox)" >&2
        exit 1
    fi
    if command -v swapon >/dev/null 2>&1; then
        swapon /dev/zram0 || {
            echo "copper-zram: swapon /dev/zram0 failed" >&2
            exit 1
        }
    elif /bin/busybox --list 2>/dev/null | grep -qx swapon; then
        /bin/busybox swapon /dev/zram0 || {
            echo "copper-zram: busybox swapon /dev/zram0 failed" >&2
            exit 1
        }
    else
        echo "copper-zram: no swapon (neither util-linux nor busybox)" >&2
        exit 1
    fi
fi

# zram's "seek" is free: read single pages and reclaim anonymous pages before
# page cache (cheap to re-read from the ISO). Only root can write these; an
# unprivileged re-run must not print busybox's own redirection error and then
# claim it did something. A failed tuning write on a real root run earns a line.
if [ "$(id -u)" = 0 ]; then
    if ! echo 100 > /proc/sys/vm/swappiness 2>/dev/null; then
        echo "copper-zram: could not tune /proc/sys/vm/swappiness" >&2
    fi
    if ! echo 0 > /proc/sys/vm/page-cluster 2>/dev/null; then
        echo "copper-zram: could not tune /proc/sys/vm/page-cluster" >&2
    fi
fi

# This run set swap up; a later re-run found it already on and changed nothing.
if [ "$swapped_on" = 1 ]; then
    echo "copper-zram: ${size_mb}M compressed swap on /dev/zram0"
fi
