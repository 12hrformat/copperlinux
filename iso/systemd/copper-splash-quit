#!/bin/sh
# Copper Linux -- let the whole boot animation play, then hand the console back.
# copper-plymouth-quit.service used to quit as soon as the network was up, around
# frame 20 of 150, cutting the animation off under the wizard's form.
# How long to wait comes from the theme's own frame_count and SetRefreshRate, so
# re-exporting with more frames cannot silently outrun the wait.
# The clock starts at /run/plymouth/started (stamped by copper-splash-show);
# /proc/uptime is monotonic, date(1) is not, and the boot clock often jumps.
set -u

SCRIPT=/usr/share/plymouth/themes/copper/copper.script

frames=""
rate=""
if [ -r "$SCRIPT" ]; then
    frames=$(sed -n \
        's/^[[:space:]]*frame_count[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        "$SCRIPT" | head -n 1)
    rate=$(sed -n \
        's/^[[:space:]]*Plymouth\.SetRefreshRate[[:space:]]*(\([0-9][0-9]*\)).*/\1/p' \
        "$SCRIPT" | head -n 1)
fi
[ -n "$frames" ] || frames=150
[ -n "$rate" ] || rate=12
case "$frames" in ''|*[!0-9]*) frames=150 ;; esac
case "$rate" in ''|*[!0-9]*) rate=12 ;; esac
[ "$rate" -gt 0 ] || rate=12

# Rounded up: a partly played last frame still counts as played.
want=$(( (frames + rate - 1) / rate ))

# Nothing to wait for without plymouthd: --ping is cheap, as copper-init uses it.
if ! /usr/bin/plymouth --ping >/dev/null 2>&1; then
    rm -f /run/plymouth/started
    exit 0
fi

start=$(cat /run/plymouth/started 2>/dev/null)
case "$start" in
    ''|*[!0-9]*) start=$(cut -d. -f1 /proc/uptime 2>/dev/null) ;;
esac
[ -n "$start" ] || start=0

now=$(cut -d. -f1 /proc/uptime 2>/dev/null)
[ -n "$now" ] || now=$start
while [ $((now - start)) -lt "$want" ]; do
    sleep 1
    now=$(cut -d. -f1 /proc/uptime 2>/dev/null)
    [ -n "$now" ] || now=$((start + want))
done

/usr/bin/plymouth --quit || true
# Wait for the daemon to RELEASE the VT, not just receive the request: the wizard
# draws on that console a moment later.
/usr/bin/plymouth --wait >/dev/null 2>&1 || true
rm -f /run/plymouth/started
exit 0
