# Copper Linux — the boot splash, owned by the service manager now.
# Started from PID 1 (splash_start) and quit before console handover; after the
# systemd swap only the console half kept the "something else is PID 1" branch,
# so nothing started the splash and the machine booted to plain text.
# This unit is that owner, wanted by sysinit.target so it is up before the first
# status line. Type=forking: plymouthd daemonises and writes the pid file the
# console half waits on; /run/plymouth is RuntimeDirectory=.
# ExecStartPost stamps /run/plymouth/started with the monotonic clock as it asks
# for the first frame; copper-plymouth-quit waits out the theme's frame count.
# Switches are Copper's, not the package's: grub.cfg asks for "splash", ignore-udev
# skips enumeration this image never runs, ignore-serial-consoles keeps the serial
# port out of the display, and copper-init used to pass both itself.
# DefaultDependencies=no keeps it out of automatic edges, like copper-tty-clear.
[Unit]
Description=Copper Linux boot splash
DefaultDependencies=no
# Opt-in: without the kernel's "splash" token (verbose/debug) this unit is skipped,
# not failed, so those entries stay plain text.
ConditionKernelCommandLine=splash
After=systemd-vconsole-setup.service
Before=copper-network.service copper-firstboot.service copper-console.service copper-tty-clear.service
# DefaultDependencies=no also drops shutdown.target's edges, so plymouthd had no
# stop job: it held DRM and tty1 into systemd-shutdown and stayed over the shutdown
# message. Conflicts=/Before= put it back in the stop transaction ahead of the
# console users; by then copper-plymouth-quit has normally ended it already.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=forking
RuntimeDirectory=plymouth
PIDFile=/run/plymouth/pid
ExecStart=/usr/sbin/plymouthd --mode=boot --pid-file=/run/plymouth/pid --ignore-serial-consoles
ExecStartPost=-/usr/bin/copper-splash-show
# Clean exit, not a signal, so the daemon drops display/VT in order; bounded small.
ExecStop=-/usr/bin/plymouth --quit
TimeoutStopSec=3s

[Install]
WantedBy=sysinit.target
