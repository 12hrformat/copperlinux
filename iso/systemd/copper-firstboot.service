# Copper Linux — the first-boot wizard.
# Runs once on the console, before the login shell: ConditionPathExists=! on
# /etc/copper-firstboot.done is the "once" mechanism (copper-init stat()ed it).
# Type=oneshot + RemainAfterExit=yes gives copper.target an ordering point to hang
# copper-console.service off, and the wizard must finish before the shell starts.
# It needs a controlling terminal: getpass() reads /dev/tty, so StandardInput=tty
# pins stdin at tty1 and TTYPath= makes it the controlling tty (the C code used to
# setsid/TIOCSCTTY itself; under --console it dups the service's stdin).
#
[Unit]
Description=Copper first-boot wizard
ConditionPathExists=!/etc/copper-firstboot.done
# Wants=, not Requires=: a seatd that cannot start must not cancel the wizard --
# no account, no persistence offered, and a console with nobody to log in as.
Wants=copper-seatd.service
After=copper-seatd.service copper-network.service
Before=copper-console.service
# The wizard draws its whole form on tty1, and getty@tty1.service wants the same
# tty (getty.target wants it, multi-user.target wants both branches) with nothing
# ordering them: the login banner lands across the form.
# Conflicts= drops getty's start job outright, so the banner is never printed.
# Measured, not assumed: with a conflict and no ordering the job is dropped; the
# ordering only decides which wins when both are wanted. This is the same conflict
# copper-console.service has, one unit later -- Before= means its own Conflicts=
# never covered the wizard's window on a first boot.
Conflicts=getty@tty1.service
# It formats the persistence disk, so it needs udev's block devices, not a
# half-populated /dev.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/copper-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=no

[Install]
WantedBy=copper.target
