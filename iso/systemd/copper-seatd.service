# Copper Linux — the seat daemon.
# Under systemd, what copper-init's start_seatd() did: `seatd -g _seatd`, which
# startniri finds on /run/seatd.sock. logind is the migration's eventual answer,
# but swapping seats and PID 1 together would give one dark screen two suspects.
# -g _seatd makes the socket group-owned so the wizard's session user (added to
# _seatd by firstboot) can open it without root.
# A boot proved PATH is not fixed: the package installs /usr/sbin/seatd while the
# unit said /usr/bin/seatd, so systemd ran a missing file, Restart=on-failure
# stormed [FAILED] over the wizard's form, and the seat never came up. Search both.
[Unit]
Description=Copper seat daemon (seatd)
# No Documentation=, as in copper-network.service: this image has no man or man
# pages, so man:seatd(1) points at nothing anyone can open.
ConditionPathExists=|/usr/bin/seatd
ConditionPathExists=|/usr/sbin/seatd
After=systemd-udev-settle.service
Before=copper-console.service
# An immediate exit must not become a restart storm over the wizard's tty: five
# fast tries then stop (it is still wanted, so a later restart works). Both keys
# are in [Unit] where systemd reads them -- in [Service] they are silently
# ignored "Unknown key" lines that the stage's verify filter rejects.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
# Search both directories; exec replaces the shell so seatd stays the unit's
# process and its exit status is the unit's.
ExecStart=/bin/sh -c 'for p in /usr/bin/seatd /usr/sbin/seatd; do \
    [ -x "$p" ] && exec "$p" -g _seatd; done; \
    echo "copper-seatd: no seatd binary at /usr/bin/seatd or /usr/sbin/seatd" >&2; \
    exit 127'
# A daemon for the life of the machine; StartLimit* in [Unit] bounds restarts.
Restart=on-failure
RestartSec=5
RuntimeDirectory=seatd
# seatd binds /run/seatd.sock with the _seatd group itself -- no socket unit:
# activation would make "seatd is down" look like "the seat is up".

[Install]
WantedBy=copper.target
