#!/bin/sh
# Copper Linux -- take the compressed swap down BEFORE systemd-shutdown does.
# The ~10 minute `sudo reboot` was this: systemd-shutdown's swapoff_all() has NO
# timeout (arg_timeout only reaches broadcast_signal()), and draining a full zram
# device back into tight RAM took minutes under "Deactivating swaps.".
#
# So the unit stops itself as ExecStop, inside systemd's stop transaction where
# TimeoutStopSec is a real bound. Stop ordering has already taken the desktop
# down (console is After=sysinit.target, this unit is Before=), freeing pages.
# drop_caches first gives swapoff the cheapest memory to reclaim; without it the
# kernel reclaims while swapoff runs and a second turns into a minute.
#
# POSIX sh; busybox ash has no local/arrays (see assert_shell_scripts_parse()).

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

Z=/sys/block/zram0
[ -e "$Z" ] || exit 0

# Only if actually in use: a skipped start leaves /proc/swaps empty and shutdown quick.
if ! grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null; then
    exit 0
fi

echo "copper-zram-stop: flushing page cache before swapoff" >&2
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

if command -v swapoff >/dev/null 2>&1; then
    swapoff /dev/zram0
elif /bin/busybox --list 2>/dev/null | grep -qx swapoff; then
    /bin/busybox swapoff /dev/zram0
else
# Never block shutdown on a tool the image lacks; systemd's slow path still runs.
    echo "copper-zram-stop: no swapoff tool; systemd-shutdown will do it" >&2
    exit 0
fi

# Verify rather than trust the status: swapoff(2) can fail EBUSY after a partial job.
if grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null; then
    echo "copper-zram-stop: swapoff did not finish; systemd-shutdown will retry" >&2
    exit 0
fi

# Resetting the device releases the compressed store too; best effort.
echo 0 > "$Z/disksize" 2>/dev/null || true
echo "copper-zram-stop: /dev/zram0 deactivated"
