# Copper Linux -- compressed swap in RAM, set up before anything heavy starts.
# The live image has no swap: /init's overlay is half of RAM and the desktop wants
# the rest, so allocation bursts stall the session ("niri froze" on 4 GB). zram
# gives the burst somewhere to go. DefaultDependencies=no lets this run INSIDE
# sysinit (a normal service's implicit After=sysinit.target would cycle with
# Before=sysinit.target). ConditionPathExists: no CONFIG_ZRAM means no zram0, and
# a skipped unit stays off the wizard's tty (bug 47: no [FAILED] over the form).
[Unit]
Description=Copper compressed swap (zram)
DefaultDependencies=no
ConditionPathExists=/sys/block/zram0
Before=sysinit.target swap.target
After=systemd-udevd.service
# DefaultDependencies=no also drops shutdown.target's implicit edges, so without
# Conflicts=/Before= this unit has no stop job: zram0 stays in /proc/swaps into
# systemd-shutdown, whose unbounded swapoff_all() is what ExecStop exists to avoid.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Honest status: zram0 that cannot swapon is a defect, not a silent pass.
ExecStart=/usr/bin/copper-zram
# Stop inside the stop transaction where TimeoutStopSec bounds the drain; ordering
# takes the desktop down first, so the swap is cheap. drop_caches helps pages back.
#
# TimeoutStopSec=30s overrides the 10 s global default -- swap drain is slower --
# but stays bounded. ExecStop=- so a failed drain cannot hold the reboot.
ExecStop=-/usr/bin/copper-zram-stop
TimeoutStopSec=30s

[Install]
WantedBy=sysinit.target
